---
import { SignOutButton, Show, UserButton } from "@clerk/astro/components";

const response = await fetch(`${Astro.url.origin}/api/headers/api`);
let unreadCount = 0;
try {
  const data = await response.json();
  unreadCount = data.unreadCount || 0;
} catch(e) {}
---

<!-- Botón toggle para móvil con diseño mejorado -->
<div class="fixed top-4 left-4 z-50 sm:hidden">
  <button
    id="sidebar-toggle"
    type="button"
    class="p-2.5 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 rounded-xl shadow-lg border border-gray-100 dark:border-gray-700 focus:outline-none transition-all active:scale-90"
  >
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
    </svg>
  </button>
</div>

<!-- Overlay para cerrar el sidebar en móvil -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 z-30 bg-gray-900/60 backdrop-blur-sm sm:hidden hidden opacity-0 transition-opacity duration-300"
>
</div>

<!-- Sidebar Premium -->
<aside
  id="separator-sidebar"
  class="fixed top-0 left-0 z-40 w-72 h-screen transition-all duration-500 ease-in-out -translate-x-full sm:translate-x-0 bg-white dark:bg-gray-900 border-r border-gray-100 dark:border-gray-800 flex flex-col shadow-2xl sm:shadow-none"
  aria-label="Sidebar"
  transition:persist="sidebar"
>
  <!-- Area de Marca / Logo -->
  <div class="p-6 pb-2">
    <a href="/dashboard" class="flex items-center gap-3 group">
      <div class="w-10 h-10 bg-gradient-to-tr from-indigo-600 to-blue-500 rounded-xl flex items-center justify-center shadow-lg shadow-indigo-200 dark:shadow-none transition-transform group-hover:rotate-6">
        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
      </div>
      <div>
        <span class="text-xl font-black text-gray-900 dark:text-white tracking-tighter block leading-none">PSICOLOGIC</span>
        <span class="text-[10px] font-bold text-indigo-500 uppercase tracking-widest leading-none">Admin Panel</span>
      </div>
    </a>
  </div>

  <!-- Navegación Principal -->
  <nav class="flex-1 px-4 py-6 overflow-y-auto scrollbar-hide">
    <div class="mb-4">
      <p class="px-4 text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-4">Menú Principal</p>
      <ul class="space-y-1.5">
        <li>
          <a href="/dashboard" class="sidebar-link group flex items-center px-4 py-3 text-sm font-bold text-gray-600 dark:text-gray-400 rounded-2xl transition-all hover:bg-indigo-50 dark:hover:bg-indigo-900/10 hover:text-indigo-600 dark:hover:text-indigo-400">
            <svg class="w-5 h-5 mr-3 transition-colors group-[.active]:text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
            </svg>
            Dashboard
          </a>
        </li>
        <li>
          <a href="/dashboard/message" id="messages-link" class="sidebar-link group flex items-center px-4 py-3 text-sm font-bold text-gray-600 dark:text-gray-400 rounded-2xl transition-all hover:bg-indigo-50 dark:hover:bg-indigo-900/10 hover:text-indigo-600 dark:hover:text-indigo-400">
            <svg class="w-5 h-5 mr-3 transition-colors group-[.active]:text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
            </svg>
            <span class="flex-1">Mensajes</span>
            <span id="unread-badge" class={`px-2 py-0.5 bg-red-500 text-white text-[10px] font-black rounded-lg shadow-sm animate-pulse ${unreadCount > 0 ? '' : 'hidden'}`}>
              {unreadCount}
            </span>
          </a>
        </li>
        <li>
          <a href="/dashboard/payments" class="sidebar-link group flex items-center px-4 py-3 text-sm font-bold text-gray-600 dark:text-gray-400 rounded-2xl transition-all hover:bg-indigo-50 dark:hover:bg-indigo-900/10 hover:text-indigo-600 dark:hover:text-indigo-400">
            <svg class="w-5 h-5 mr-3 transition-colors group-[.active]:text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
            Pagos
          </a>
        </li>
      </ul>
    </div>

    <div>
      <p class="px-4 text-[10px] font-black text-gray-400 dark:text-gray-500 uppercase tracking-widest mb-4">Sistema</p>
      <ul class="space-y-1.5">
        <li>
          <a href="/dashboard/settings" class="sidebar-link group flex items-center px-4 py-3 text-sm font-bold text-gray-600 dark:text-gray-400 rounded-2xl transition-all hover:bg-indigo-50 dark:hover:bg-indigo-900/10 hover:text-indigo-600 dark:hover:text-indigo-400">
            <svg class="w-5 h-5 mr-3 transition-colors group-[.active]:text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Configuración
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Perfil de Usuario y Logout -->
  <div class="p-4 border-t border-gray-100 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-800/20">
    <div class="flex items-center gap-3 px-2 py-3 mb-2">
      <div class="scale-110">
        <UserButton afterSignOutUrl="/" />
      </div>
      <div class="flex-1 min-w-0">
        <Show when="signed-in">
          <p class="text-sm font-black text-gray-900 dark:text-white truncate" id="user-display-name">Cargando...</p>
          <p class="text-[10px] font-bold text-gray-500 uppercase tracking-tighter">Sesión Activa</p>
        </Show>
      </div>
    </div>
    
    <SignOutButton redirectUrl="/" asChild>
      <button class="w-full flex items-center justify-center gap-2 px-4 py-3 text-xs font-black text-white bg-gray-900 dark:bg-gray-700 hover:bg-red-600 dark:hover:bg-red-600 rounded-2xl transition-all shadow-lg active:scale-95 group">
        <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
        </svg>
        CERRAR SESIÓN
      </button>
    </SignOutButton>
  </div>
</aside>

<script>
  function setupSidebar() {
    const toggleButton = document.getElementById("sidebar-toggle");
    const sidebar = document.getElementById("separator-sidebar");
    const overlay = document.getElementById("sidebar-overlay");
    const sidebarLinks = document.querySelectorAll(".sidebar-link");

    function showSidebar() {
      if (sidebar) {
        sidebar.classList.remove("-translate-x-full");
        sidebar.classList.add("translate-x-0");
      }
      if (overlay) {
        overlay.classList.remove("hidden");
        setTimeout(() => overlay.classList.add("opacity-100"), 10);
      }
      document.body.style.overflow = "hidden";
    }

    function hideSidebar() {
      if (sidebar) {
        sidebar.classList.add("-translate-x-full");
        sidebar.classList.remove("translate-x-0");
      }
      if (overlay) {
        overlay.classList.remove("opacity-100");
        setTimeout(() => overlay.classList.add("hidden"), 300);
      }
      document.body.style.overflow = "";
    }

    if (toggleButton) {
      toggleButton.addEventListener("click", (e) => {
        e.preventDefault();
        const isHidden = sidebar?.classList.contains("-translate-x-full");
        if (isHidden) showSidebar(); else hideSidebar();
      });
    }

    if (overlay) {
      overlay.addEventListener("click", hideSidebar);
    }

    // Link Activo Premium
    const currentPath = window.location.pathname;
    sidebarLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (href && (currentPath === href || (currentPath.startsWith(href) && href !== '/dashboard'))) {
        link.classList.add('active', 'bg-indigo-600', 'text-white', 'shadow-lg', 'shadow-indigo-200', 'dark:shadow-none');
        link.classList.remove('text-gray-600', 'dark:text-gray-400', 'hover:bg-indigo-50');
        const svg = link.querySelector('svg');
        if (svg) svg.classList.add('text-white');
      }
    });

    // Intentar obtener el nombre del usuario desde Clerk o cache
    try {
      const userEl = document.getElementById('user-display-name');
      if (userEl) {
          // Esto es una simplificación, en producción se usaría el hook de Clerk
          // o se pasaría por props desde el servidor
          userEl.textContent = "Administrador"; 
      }
    } catch(e) {}
  }

  // Lógica de conteo de mensajes
  if (!(window as any).__HEADER_JS_INITIALIZED) {
    (window as any).updateUnreadCount = async function() {
      const unreadBadge = document.getElementById("unread-badge");
      if (!unreadBadge) return;
      
      try {
        const response = await fetch("/api/headers/api");
        if (!response.ok) return;
        const data = await response.json();
        const newCount = data.unreadCount || 0;

        if (newCount > 0) {
          unreadBadge.textContent = newCount;
          unreadBadge.classList.remove("hidden");
        } else {
          unreadBadge.classList.add("hidden");
        }
      } catch (error) {}
    };

    (window as any).__HEADER_JS_INITIALIZED = true;
  }

  document.addEventListener("astro:page-load", () => {
    setupSidebar();
    if (typeof (window as any).updateUnreadCount === 'function') {
      (window as any).updateUnreadCount();
    }
  });
</script>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
