---
import DashboardWrapperSkeleton from "./SkeletonTypes/DashboardWrapperSkeleton.astro";
import CardSkeleton from "./SkeletonTypes/CardSkeleton.astro";
import ListSkeleton from "./SkeletonTypes/ListSkeleton.astro";
import AgendaSkeleton from "./SkeletonTypes/AgendaSkeleton.astro";

const { type = "default" } = Astro.props;
---

<style>
  #global-skeleton {
    position: fixed;
    inset: 0 0 0 0;
    background: white;
    z-index: 9998;
    opacity: 0;
    pointer-events: none;
    transition: opacity .25s ease;
    display: flex;
    padding: 2rem;
    gap: 1.5rem;
    overflow-y: auto;
  }

  /* Agenda skeleton might need slightly different padding or full width */
  /* Agenda skeleton - Contained within parent "relative" div */
  #global-skeleton[data-type="agenda"] {
    position: absolute; /* Changed from fixed to absolute */
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 1.5rem; /* Match parent padding usually, or use 0 if we want full overlap */
    background: rgba(255, 255, 255, 0.8); /* Semi-transparent to blend if needed, or opaque */
    z-index: 50; /* Lower z-index than toast/sidebar but high enough to cover content */
    align-items: flex-start; /* Start from top */
  }

  #global-skeleton.active {
    opacity: 1;
    pointer-events: auto;
    transition: none; /* INSTANT APPEARANCE - Fixes "not seeing it" on fast loads */
  }
</style>

<div id="global-skeleton" data-type={type}>
  <div class="w-full h-full">
    {type === "agenda" ? (
      <AgendaSkeleton />
    ) : (
      <>
        <!-- Skeleton tipo dashboard (default) -->
        <DashboardWrapperSkeleton />
        <!-- Componentes internos -->
        <div class="mt-6 space-y-4">
          <CardSkeleton />
          <CardSkeleton />
          <ListSkeleton />
        </div>
      </>
    )}
  </div>
</div>

<script>
  import "/src/lib/GlobalFetchTracker.js";

  function initSkeleton() {
    const sk = document.getElementById("global-skeleton");
    if (!sk) return;

    // Handler for fetch events
    const show = () => sk.classList.add("active");
    const hide = () => setTimeout(() => sk.classList.remove("active"), 300); // 300ms fade/delay out

    window.removeEventListener("global:fetch-start", show);
    window.removeEventListener("global:fetch-end", hide);
    window.addEventListener("global:fetch-start", show);
    window.addEventListener("global:fetch-end", hide);

    // Forces skeleton to show immediately when navigation starts
    document.addEventListener("astro:before-preparation", () => {
        sk.classList.add("active");
        // Optional: Force it to stay visible for at least a moment if desired? 
        // But instant appearance usually solves the perception issue.
    });
  }

  // Initialize on first load and after every navigation
  document.addEventListener('astro:page-load', initSkeleton);
</script>
