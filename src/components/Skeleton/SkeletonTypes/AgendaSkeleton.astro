<div
    class="h-full w-full animate-pulse flex flex-col bg-white dark:bg-gray-900"
>
    <!-- Gmail-like Header Skeleton -->
    <div
        class="flex items-center justify-between p-4 border-b border-gray-100 dark:border-gray-800"
    >
        <div class="flex items-center gap-4">
            <div class="h-8 w-8 bg-gray-200 dark:bg-gray-700 rounded-full">
            </div>
            {/* Hamburger/Logo */}
            <div class="h-6 w-32 bg-gray-200 dark:bg-gray-700 rounded"></div>
            {/* Month Title */}
        </div>
        <div class="flex gap-2">
            <div class="h-9 w-24 bg-gray-200 dark:bg-gray-700 rounded-md"></div>
            {/* View Switcher */}
            <div class="h-9 w-9 bg-gray-200 dark:bg-gray-700 rounded-full">
            </div>
            {/* Profile */}
        </div>
    </div>

    <!-- Main Content -->
    <div class="flex flex-1 overflow-hidden">
        <!-- Sidebar Mini Calendar Skeleton (Hidden on small screens) -->
        <div
            class="hidden lg:flex w-64 flex-col border-r border-gray-100 dark:border-gray-800 p-4 space-y-6"
        >
            <div
                class="h-12 w-32 bg-gray-200 dark:bg-gray-700 rounded-full mb-4"
            >
            </div>
            {/* Create Button */}
            <div class="h-48 w-full bg-gray-100 dark:bg-gray-800 rounded-md">
            </div>
            {/* Mini Calendar */}
            <div class="space-y-2">
                <div class="h-4 w-3/4 bg-gray-100 dark:bg-gray-800 rounded">
                </div>
                <div class="h-4 w-1/2 bg-gray-100 dark:bg-gray-800 rounded">
                </div>
            </div>
        </div>

        <!-- Main Grid -->
        <div class="flex-1 flex flex-col relative">
            <!-- Week Header -->
            <div
                class="grid grid-cols-7 border-b border-gray-100 dark:border-gray-800"
            >
                {
                    Array.from({ length: 7 }).map((_, i) => (
                        <div class="h-12 border-l border-gray-50 dark:border-gray-800 flex flex-col items-center justify-center">
                            <div class="h-3 w-8 bg-gray-200 dark:bg-gray-700 rounded mb-1" />
                            <div class="h-6 w-6 bg-gray-200 dark:bg-gray-700 rounded-full" />
                        </div>
                    ))
                }
            </div>

            <!-- Time Grid -->
            <div class="flex-1 overflow-hidden relative">
                {/* Horizontal Lines */}
                <div class="absolute inset-0 flex flex-col">
                    {
                        Array.from({ length: 10 }).map(() => (
                            <div class="flex-1 border-b border-gray-50 dark:border-gray-800" />
                        ))
                    }
                </div>

                {/* Vertical Lines */}
                <div class="absolute inset-0 grid grid-cols-7 h-full">
                    {
                        Array.from({ length: 7 }).map(() => (
                            <div class="border-l border-gray-50 dark:border-gray-800 h-full" />
                        ))
                    }
                </div>

                {/* Random Event Placeholders (Cleaner) */}
                <div
                    class="absolute top-[20%] left-[14.28%] w-[14.28%] h-[10%] p-1"
                >
                    <div
                        class="w-full h-full bg-indigo-100 dark:bg-indigo-900/30 rounded-md"
                    >
                    </div>
                </div>
                <div
                    class="absolute top-[50%] left-[42.84%] w-[14.28%] h-[15%] p-1"
                >
                    <div
                        class="w-full h-full bg-green-100 dark:bg-green-900/30 rounded-md"
                    >
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
