---
import innoTechLogoWhite from "../../public/img/logo/logo_white.png";
import { SignInButton } from "@clerk/astro/components";
---

<div class="relative min-h-screen overflow-hidden bg-[#0a0a0b] flex flex-col items-center justify-center px-6 antialiased">
  <!-- Efectos de Fondo Atmosférico -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[600px] bg-indigo-600/10 blur-[150px] rounded-full"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-blue-600/5 blur-[120px] rounded-full"></div>
  <div class="absolute top-1/2 right-0 w-[400px] h-[400px] bg-purple-600/5 blur-[100px] rounded-full"></div>

  <!-- Toast container -->
  <div id="toast-container" class="fixed top-8 right-8 z-50 flex flex-col gap-3"></div>

  <main class="relative z-10 w-full max-w-5xl flex flex-col items-center">
    <!-- Logo con Animación Suave -->
    <img
      src={innoTechLogoWhite.src}
      alt="InnoTech Logo"
      class="mb-16 h-28 w-auto filter drop-shadow-[0_0_20px_rgba(255,255,255,0.1)] hover:scale-105 transition-transform duration-700"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full">
      <!-- Card Profesional -->
      <div class="group relative bg-white/[0.03] backdrop-blur-2xl border border-white/10 rounded-[2.5rem] p-10 overflow-hidden hover:border-indigo-500/30 transition-all duration-500 shadow-2xl">
        <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/10 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
        
        <div class="relative space-y-6">
          <div class="inline-flex px-3 py-1 bg-indigo-500/10 rounded-full border border-indigo-500/20">
            <span class="text-[10px] font-black uppercase tracking-widest text-indigo-400">Portal Profesional</span>
          </div>
          <h2 class="text-4xl font-black text-white tracking-tighter leading-tight">
            Gestión <br/><span class="text-indigo-400 font-medium">Integral</span>
          </h2>
          <p class="text-gray-400 text-lg leading-relaxed font-medium">
            Accede a herramientas de vanguardia diseñadas para potenciar el bienestar emocional a través de la analítica y el acompañamiento profesional.
          </p>
          
          <div class="pt-4">
            <div class="relative inline-block group/btn overflow-hidden rounded-2xl">
              <div class="absolute inset-0 bg-gradient-to-r from-indigo-600 to-blue-600 transition-transform group-hover/btn:scale-105"></div>
              <div class="relative px-8 py-4 text-sm font-black text-white tracking-widest uppercase cursor-pointer">
                <SignInButton mode="modal" class="w-full h-full" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card Lúdica -->
      <div class="group relative bg-white/[0.03] backdrop-blur-2xl border border-white/10 rounded-[2.5rem] p-10 overflow-hidden hover:border-emerald-500/30 transition-all duration-500 shadow-2xl">
        <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity"></div>
        
        <div class="relative space-y-6">
          <div class="inline-flex px-3 py-1 bg-emerald-500/10 rounded-full border border-emerald-500/20">
            <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400">Experiencia Lúdica</span>
          </div>
          <h2 class="text-4xl font-black text-white tracking-tighter leading-tight">
            Explora <br/><span class="text-emerald-400 font-medium">Emociones</span>
          </h2>
          <p class="text-gray-400 text-lg leading-relaxed font-medium">
            Fortalece habilidades sociales y emocionales a través de dinámicas seguras y experiencias transformadoras basadas en el juego.
          </p>
          
          <div class="pt-4">
            <div id="btn-game-login" class="relative inline-block group/btn overflow-hidden rounded-2xl">
              <div class="absolute inset-0 bg-gradient-to-r from-emerald-600 to-teal-600 transition-transform group-hover/btn:scale-105"></div>
              <div class="relative px-8 py-4 text-sm font-black text-white tracking-widest uppercase cursor-pointer">
                <SignInButton mode="modal" class="w-full h-full" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer / Credenciales -->
    <div class="mt-20 text-center">
      <p class="text-[10px] font-bold text-gray-500 uppercase tracking-[0.4em]">Powered by InnoTech Labs © 2025</p>
    </div>
  </main>
</div>

<script>
  import { showToast } from "../utils/toast.js";

  document.addEventListener("DOMContentLoaded", () => {
    // Verificar si hay un mensaje en la URL
    const urlParams = new URLSearchParams(window.location.search);
    const message = urlParams.get('message');

    if (message) {
      const decodedMessage = decodeURIComponent(message);
      showToast(decodedMessage, 'error', 8000);

      // Limpiar la URL para que no muestre el mensaje al recargar
      window.history.replaceState({}, document.title, window.location.pathname);
    }

    const gameBtn = document.getElementById("btn-game-login");
    if (gameBtn) {
      const setGameAuth = () => {
        try {
          console.log("🎮 Game login initiated - Setting auth_source");
          document.cookie =
            "auth_source=game:memory; Path=/; Max-Age=86400; SameSite=Lax";
          localStorage.setItem("auth_source", "game:memory");
          window.dispatchEvent(new Event("auth_source_changed"));
        } catch (e) {
          console.warn("Error setting auth_source:", e);
        }
      };

      // Listen for both click and mousedown
      gameBtn.addEventListener("click", setGameAuth);
      gameBtn.addEventListener("mousedown", setGameAuth);
    }
  });
</script>

<style>
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(30px); filter: blur(10px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  
  main {
    animation: fade-up 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>
