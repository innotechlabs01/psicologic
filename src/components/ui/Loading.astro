---
interface Props {
    text?: string;
    centered?: boolean;
}

const { text = 'Cargando...', centered = true } = Astro.props;
---

<div class:list={[
    "loading-container",
    centered && "flex items-center justify-center"
]}>
    <div class="loading-spinner">
        <div class="spinner"></div>
        {text && <span class="loading-text">{text}</span>}
    </div>
</div>

<style>
    .loading-container {
        min-height: 200px;
        width: 100%;
        padding: 2rem;
    }

    .loading-spinner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 3px solid var(--muted);
        border-top-color: var(--primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    .loading-text {
        color: var(--muted-foreground);
        font-size: 0.875rem;
        font-weight: 500;
    }

    @keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }
</style>
