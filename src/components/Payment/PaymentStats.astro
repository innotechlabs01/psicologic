---
interface Props {
  paymentCount: number;
  lastPaymentDate: string | null;
  nextPaymentDate: string | null;
  subscriptionStatus: string;
  daysToNext: number;
  isActive: boolean;
}

const { 
  paymentCount, 
  lastPaymentDate, 
  nextPaymentDate, 
  subscriptionStatus,
  daysToNext,
  isActive
} = Astro.props;

const formatDate = (date: string) => {
  const newDate = new Date(date);
  if (!date) return 'Sin fecha';
  return newDate.toLocaleDateString('en-US', { 
        day: '2-digit', 
        month: '2-digit', 
        year: 'numeric' 
    });
};

const getStatusColor = (status: string) => {
  switch(status) {
    case 'trial': return 'bg-yellow-100 text-yellow-800';
    case 'active': return 'bg-green-100 text-green-800';
    case 'inactive': return 'bg-gray-100 text-gray-800';
    case 'expired': return 'bg-red-100 text-red-800';
    default: return 'bg-gray-100 text-gray-800';
  }
};

const getStatusText = (status: string) => {
  switch(status) {
    case 'trial': return 'Prueba';
    case 'approved': return 'Activa';
    case 'rejected': return 'Inactiva';
    case 'canceled': return 'Cancelada';
    default: return 'Desconocido';
  }
};
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <!-- Total de Pagos -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex items-center">
      <div class="flex-shrink-0">
        <div class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1"></path>
          </svg>
        </div>
      </div>
      <div class="ml-4">
        <p class="text-sm font-medium text-gray-500">Total Pagos</p>
        <p class="text-2xl font-semibold text-gray-900">{paymentCount}</p>
      </div>
    </div>
  </div>

  <!-- Estado de Suscripción -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex items-center">
      <div class="flex-shrink-0">
        <div class={`w-8 h-8 ${isActive ? 'bg-green-500' : 'bg-gray-500'} rounded-full flex items-center justify-center`}>
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <div class="ml-4">
        <p class="text-sm font-medium text-gray-500">Estado</p>
        <span class={`inline-flex px-2 py-1 text-xs font-semibold rounded-full ${getStatusColor(subscriptionStatus)}`}>
          {getStatusText(subscriptionStatus)}
        </span>
      </div>
    </div>
  </div>

  <!-- Próximo Pago -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex items-center">
      <div class="flex-shrink-0">
        <div class={`w-8 h-8 ${daysToNext <= 7 ? 'bg-red-500' : 'bg-orange-500'} rounded-full flex items-center justify-center`}>
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <div class="ml-4">
        <p class="text-sm font-medium text-gray-500">Próximo Pago</p>
        <p class="text-sm font-semibold text-gray-900">
          {daysToNext > 0 ? `${daysToNext} días` : 'Vencida'}
        </p>
        <p class="text-xs text-gray-500">{formatDate(nextPaymentDate ?? '')}</p>
      </div>
    </div>
  </div>

  <!-- Último Pago -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <div class="flex items-center">
      <div class="flex-shrink-0">
        <div class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
        </div>
      </div>
      <div class="ml-4">
        <p class="text-sm font-medium text-gray-500">Último Pago</p>
        <p class="text-sm font-semibold text-gray-900">{formatDate(lastPaymentDate ?? '')}</p>
      </div>
    </div>
  </div>
</div>