---

---

<style>
  .modal-backdrop {
    background: rgba(0, 0, 0, 0.45);
  }
  .modal-card {
    background: var(--color-gris-claro);
    border-radius: 8px;
  }
  .btn-primary {
    background: linear-gradient(
      90deg,
      var(--color-azul-principal),
      var(--color-morado-principal)
    );
    color: white;
  }
  .btn-outline {
    border: 1px solid var(--color-azul-principal);
    color: var(--color-azul-oscuro);
  }
</style>

<div class="p-4">
  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="text-xl font-semibold text-[var(--color-azul-oscuro)]">
        Pacientes agregados
      </h2>
      <p class="text-sm text-[var(--color-azul-oscuro)]/70">
        Ver y administrar los pacientes que has agregado para jugar
      </p>
    </div>
    <div class="flex items-center gap-3">
      <input
        id="search"
        placeholder="Buscar por nombre, cédula o email"
        class="px-3 py-2 rounded-md border border-[var(--color-gris-claro)]"
      />
      <label
        class="flex items-center gap-2 text-sm text-[var(--color-azul-oscuro)]"
      >
        <input id="show-inactive" type="checkbox" />
        <span>Mostrar inactivos</span>
      </label>
      <button id="open-new" class="px-4 py-2 rounded-md btn-primary"
        >Nuevo paciente</button
      >
    </div>
  </div>

  <div class="overflow-x-auto bg-white rounded-md shadow-sm">
    <table class="w-full table-fixed text-left">
      <thead class="bg-[var(--color-gris-claro)]">
        <tr>
          <th class="px-4 py-2">Nombre</th>
          <th class="px-4 py-2">Cédula</th>
          <th class="px-4 py-2">Email</th>
          <th class="px-4 py-2">Estado civil</th>
          <th class="px-4 py-2">Membresía</th>
          <th class="px-4 py-2">Ingresado</th>
        </tr>
      </thead>
      <tbody id="patients-body">
        <tr><td colspan="6" class="p-4 text-center">Cargando...</td></tr>
      </tbody>
    </table>
  </div>

  <div class="flex justify-between items-center mt-4">
    <div id="pagination-info" class="text-sm text-[var(--color-azul-oscuro)]">
      &nbsp;
    </div>
    <div class="flex gap-2">
      <button id="prev-page" class="px-3 py-2 rounded-md btn-outline"
        >Anterior</button
      >
      <button id="next-page" class="px-3 py-2 rounded-md btn-outline"
        >Siguiente</button
      >
    </div>
  </div>

  <!-- Modal -->
  <div
    id="modal"
    class="fixed inset-0 hidden flex items-center justify-center modal-backdrop z-50"
  >
    <div class="w-full max-w-xl modal-card p-6">
      <h3 class="text-lg font-bold text-[var(--color-azul-oscuro)] mb-4">
        Registrar paciente
      </h3>
      <form id="patient-form" class="grid grid-cols-1 gap-3">
        <input
          name="name"
          placeholder="Nombre completo"
          required
          class="px-3 py-2 rounded border"
        />
        <input
          name="cedula"
          placeholder="Cédula"
          required
          class="px-3 py-2 rounded border"
        />
        <input
          name="email"
          type="email"
          placeholder="Email"
          required
          class="px-3 py-2 rounded border"
        />
        <select name="marital_status" class="px-3 py-2 rounded border">
          <option value="soltero">Soltero(a)</option>
          <option value="casado">Casado(a)</option>
          <option value="union">Unión libre</option>
          <option value="divorciado">Divorciado(a)</option>
          <option value="viudo">Viudo(a)</option>
        </select>

        <div class="flex justify-end gap-2 mt-2">
          <button type="button" id="close-modal" class="px-4 py-2 btn-outline"
            >Cancelar</button
          >
          <button type="submit" class="px-4 py-2 btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Reactivate Modal -->
  <div
    id="reactivate-modal"
    class="fixed inset-0 hidden flex items-center justify-center modal-backdrop z-50"
  >
    <div class="w-full max-w-md modal-card p-6">
      <h3 class="text-lg font-bold text-[var(--color-azul-oscuro)] mb-4">
        Confirmar reactivación
      </h3>
      <p id="reactivate-text" class="mb-4 text-[var(--color-azul-oscuro)]">
        ¿Reactivar paciente?
      </p>
      <div class="flex justify-end gap-2 mt-2">
        <button
          type="button"
          id="reactivate-cancel"
          class="px-4 py-2 btn-outline">Cancelar</button
        >
        <button
          type="button"
          id="reactivate-confirm"
          class="px-4 py-2 btn-primary">Reactivar</button
        >
      </div>
    </div>
  </div>

  <script type="module">
    // Run initialization logic within a function so it can be controlled
    function initUserManagement() {
      const searchInput = document.getElementById("search");
      const patientsBody = document.getElementById("patients-body");
      const paginationInfo = document.getElementById("pagination-info");
      const prevBtn = document.getElementById("prev-page");
      const nextBtn = document.getElementById("next-page");

      const modal = document.getElementById("modal");
      const openNew = document.getElementById("open-new");
      const closeModal = document.getElementById("close-modal");
      const form = document.getElementById("patient-form");
      const showInactiveCheckbox = document.getElementById("show-inactive");

      // Reactivate modal
      const reactivateModal = document.getElementById("reactivate-modal");
      const reactivateConfirm = document.getElementById("reactivate-confirm");
      const reactivateCancel = document.getElementById("reactivate-cancel");
      let pendingReactivateId = null;

      // If key elements are missing, we are likely not on the correct state or view
      if (!searchInput || !patientsBody || !form) {
        return;
      }

      let page = 1;
      const limit = 10;
      let totalPages = 1;

      function showModal(show = true) {
        modal.classList.toggle("hidden", !show);
      }

      openNew?.addEventListener("click", () => {
        form.reset();
        delete form.dataset.editId;
        showModal(true);
      });
      closeModal?.addEventListener("click", () => {
        showModal(false);
        form.reset();
        delete form.dataset.editId;
      });

      function showReactivateModal(show = true, id = null, name = "") {
        pendingReactivateId = id;
        const txt = document.getElementById("reactivate-text");
        if (txt) txt.textContent = `¿Reactivar al paciente "${name}"?`;
        reactivateModal.classList.toggle("hidden", !show);
      }

      reactivateCancel?.addEventListener("click", () =>
        showReactivateModal(false),
      );

      reactivateConfirm?.addEventListener("click", async () => {
        if (!pendingReactivateId) return;
        try {
          const res = await fetch("/api/client/patients/reactivate", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: pendingReactivateId }),
          });
          const j = await res.json();
          const { showToast } = await import("/src/utils/toast.js");
          if (!res.ok || !j.ok) {
            showToast(j.error || "Error reactivando", "error");
          } else {
            showToast("Paciente reactivado", "success");
            showReactivateModal(false);
            loadPatients();
          }
        } catch (err) {
          console.error(err);
          const { showToast } = await import("/src/utils/toast.js");
          showToast("Error de red", "error");
        } finally {
          pendingReactivateId = null;
        }
      });

      showInactiveCheckbox?.addEventListener("change", () => {
        page = 1;
        loadPatients();
      });

      async function loadPatients() {
        try {
          const q = encodeURIComponent(searchInput.value || "");
          const includeInactive =
            showInactiveCheckbox && showInactiveCheckbox.checked ? 1 : 0;
          const url = `/api/client/patients/list?page=${page}&limit=${limit}&q=${q}&include_inactive=${includeInactive}`;

          const res = await fetch(url);
          if (!res.ok) {
            throw new Error("API Error: " + res.status);
          }
          const json = await res.json();
          totalPages = json.totalPages || 1;

          if (paginationInfo)
            paginationInfo.textContent = `Página ${page} de ${totalPages} — ${json.total} pacientes`;

          if (!json.data.length) {
            patientsBody.innerHTML = `<tr><td colspan="6" class="p-4 text-center">No hay pacientes</td></tr>`;
            return;
          }

          patientsBody.innerHTML = json.data
            .map(
              (p) => `
            <tr class="border-t" data-id="${p.id}">
              <td class="px-4 py-2">${p.name}</td>
              <td class="px-4 py-2">${p.document}</td>
              <td class="px-4 py-2">${p.email || ""}</td>
              <td class="px-4 py-2">${p.marital_status || ""}</td>
              <td class="px-4 py-2">${p.membership_paid ? '<span style="color:var(--color-azul-oscuro);font-weight:600">Pagado</span>' : '<span style="color:var(--color-azul-oscuro)">No</span>'}</td>
              <td class="px-4 py-2">${new Date(p.created_at).toLocaleDateString()}</td>
              <td class="px-4 py-2 text-right">
                <button class="edit-btn px-3 py-1 mr-2 rounded btn-outline">Editar</button>
                ${p.status === "inactive" ? `<button class="reactivate-btn px-3 py-1 rounded btn-primary">Reactivar</button>` : `<button class="deactivate-btn px-3 py-1 rounded btn-outline">Marcar Inactivo</button>`}
              </td>
            </tr>`,
            )
            .join("");
        } catch (err) {
          console.error("Error loading patients:", err);
          if (patientsBody) {
            patientsBody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-red-600">Error cargando: ${err.message || "Desconocido"}</td></tr>`;
          }
        }
      }

      prevBtn?.addEventListener("click", () => {
        if (page > 1) {
          page--;
          loadPatients();
        }
      });
      nextBtn?.addEventListener("click", () => {
        if (page < totalPages) {
          page++;
          loadPatients();
        }
      });

      searchInput?.addEventListener("input", () => {
        page = 1;
        loadPatients();
      });

      // Delegated events for edit/deactivate
      patientsBody.addEventListener("click", async (e) => {
        const tr = e.target.closest("tr");
        if (!tr) return;
        const id = tr.getAttribute("data-id");
        if (e.target.classList.contains("edit-btn")) {
          // fetch patient and fill form
          try {
            const res = await fetch(`/api/client/patients/${id}`);
            if (!res.ok) {
              alert("No se pudo obtener paciente");
              return;
            }
            const json = await res.json();
            const p = json.data;
            form.name.value = p.name || "";
            form.cedula.value = p.document || "";
            form.email.value = p.email || "";
            form.marital_status.value = p.marital_status || "";
            form.dataset.editId = id;
            showModal(true);
          } catch (e) {
            console.error(e);
            alert("Error de conexión");
          }
          return;
        }

        if (e.target.classList.contains("reactivate-btn")) {
          const name = tr.querySelector("td")?.textContent || "";
          showReactivateModal(true, id, name);
          return;
        }

        if (e.target.classList.contains("deactivate-btn")) {
          if (!confirm("Marcar paciente como inactivo?")) return;
          try {
            const res = await fetch(`/api/client/patients/${id}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ status: "inactive" }),
            });
            if (!res.ok) return alert("Error actualizando estado");
            loadPatients();
          } catch (e) {
            console.error(e);
            alert("Error desactivando");
          }
          return;
        }
      });

      // Submit supports both create and edit
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const body = Object.fromEntries(fd.entries());

        const editId = form.dataset.editId;
        try {
          if (editId) {
            // update
            const res = await fetch(`/api/client/patients/${editId}`, {
              method: "PATCH",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(body),
            });
            if (!res.ok) return alert("Error actualizando");
            delete form.dataset.editId;
          } else {
            body.membership_paid = 0;
            const res = await fetch("/api/client/patients/create", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(body),
            });
            if (!res.ok) return alert("Error al guardar");
          }

          showModal(false);
          page = 1;
          loadPatients();
        } catch (e) {
          console.error(e);
          alert("Error guardando");
        }
      });

      // Initial load
      loadPatients();
    }

    // Call init immediately (for initial load)
    initUserManagement();

    // Re-run on View Transitions navigation (generic handler)
    document.addEventListener(
      "astro:page-load",
      () => {
        // If we are navigating to this page, the script re-runs anyway, triggering initUserManagement.
        // If we are using persistent DOM (unlikely here), this would double-run.
        // But since we didn't add the listener NAMED, we can't remove it easily.
        // Safe bet: Rely on script re-execution as we are in the body.
      },
      { once: true },
    );
  </script>
</div>
