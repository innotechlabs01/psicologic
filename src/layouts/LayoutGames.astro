---
import Footer from "../components/Footer/footer.astro";
import HeaderClient from "../components/Header/headerClient.astro";

import ToastRoot from "../components/Toast/ToastRoot";
import { ClientRouter } from "astro:transitions";

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/css/main.css" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        const getTheme = function() {
          try {
            const stored = localStorage.getItem('global-storage');
            if (stored) {
              const data = JSON.parse(stored);
              const theme = data.state?.theme;
              if (theme && theme !== 'system') return theme;
            }
          } catch (e) {}
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        
        const theme = getTheme();
        const root = document.documentElement;
        if (theme === 'dark') {
          root.classList.add('dark');
        } else {
          root.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <!-- Header con sidebar incluido -->
    <HeaderClient />

    <!-- Contenedor principal que respeta el espacio del sidebar -->
    <div class="flex min-h-screen">
      <!-- Espacio reservado para el sidebar (invisible pero mantiene el layout) -->
      <div class="hidden sm:block sm:w-64 flex-shrink-0"></div>

      <!-- Contenido principal alineado -->
      <main class="main-content flex-2 w-full sm:w-auto">
        <div class="p-6 max-w-full relative min-h-[calc(100vh-4rem)]">
          <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2">
          </div>
          <script type="module" src="/js/toast.js"></script>
          <ToastRoot client:idle />

          <slot />
        </div>
      </main>
    </div>

    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  /* Asegurar que el contenido no se superponga con el sidebar */
  @media (min-width: 640px) {
    body {
      padding-left: 0; /* El layout flex se encarga del espaciado */
    }
  }

  /* Prevenir overflow horizontal */
  main {
    overflow-x: hidden;
  }
</style>
