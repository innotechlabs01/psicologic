---
import Footer from "../components/Footer/footer.astro";
import HeaderClient from "../components/Header/headerClient.astro";

import ToastRoot from "../components/Toast/ToastRoot";
import SkeletonManager from "../components/Skeleton/SkeletonManager.astro";
import { ClientRouter } from "astro:transitions";

const { title, skeletonType } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#007BFF" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/img/pwa/apple-touch-icon.png" />
    <script is:inline>
      // PWA: registro del service worker (spec 2026-10-19-pwa-phase1)
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) =>
            console.warn('SW registration failed:', err)
          );
        });
      }
    </script>
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-gray-100 dark:bg-gray-900">
    <!-- Header con sidebar incluido -->
    <HeaderClient />

    <!-- Contenedor principal que respeta el espacio del sidebar -->
    <div class="flex min-h-screen">
      <!-- Espacio reservado para el sidebar (invisible pero mantiene el layout) -->
      <div class="hidden sm:block sm:w-64 flex-shrink-0"></div>

      <!-- Contenido principal alineado -->
      <main class="main-content flex-2 w-full sm:w-auto">
        <div class="p-6 max-w-full relative min-h-[calc(100vh-4rem)]">
          <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2">
          </div>
          <script type="module" src="/js/toast.js"></script>
          <ToastRoot client:load />

          <!-- � Manager de Skeletons -->
          <!-- <SkeletonManager type={skeletonType} /> -->

          <slot />
        </div>
      </main>
    </div>

    <Footer />
  </body>
</html>

<style>
  html,
  body {
    background: white;
    margin: 0;
    width: 100%;
    height: 100%;
  }

  /* Asegurar que el contenido no se superponga con el sidebar */
  @media (min-width: 640px) {
    body {
      padding-left: 0; /* El layout flex se encarga del espaciado */
    }
  }

  /* Prevenir overflow horizontal */
  main {
    overflow-x: hidden;
  }
</style>
