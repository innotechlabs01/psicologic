---
// src/layouts/LayoutDashboard.astro
import Footer from "../components/Footer/footer.astro";
import Header from "../components/Header/header.astro";
import { ClientRouter } from "astro:transitions";
import { ThemeSync } from "../components/ThemeSync.tsx";

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="/css/main.css" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      (function() {
        const getTheme = () => {
          try {
            const stored = localStorage.getItem('global-storage');
            if (stored) {
              const data = JSON.parse(stored);
              const theme = data.state?.theme;
              if (theme && theme !== 'system') return theme;
            }
          } catch (e) {}
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        };
        
        const theme = getTheme();
        const root = document.documentElement;
        if (theme === 'dark') {
          root.classList.add('dark');
        } else {
          root.classList.remove('dark');
        }
      })();
    </script>
  </head>

  <body class="min-h-screen bg-background text-foreground antialiased transition-colors duration-300">
    <ThemeSync client:idle />
    
    <!-- Header Fixed -->
    <Header />

    <div class="flex min-h-screen pt-16">
      <!-- Main Content Area -->
      <main class="flex-1 w-full transition-all duration-300 ease-in-out px-4 py-8 lg:px-8 overflow-x-hidden">
        <div class="max-w-7xl mx-auto relative min-h-[calc(100vh-8rem)]">
          <div id="toast-container" class="fixed top-20 right-4 z-50 space-y-2"></div>
          
          <div id="page-content" class="animate-in fade-in duration-500">
            <slot />
          </div>
        </div>
      </main>
    </div>

    <script type="module" src="/js/toast.js"></script>
    <Footer />
  </body>
</html>

<style>
  /* Layout constraints */
  body.sidebar-open main {
    /* Mobile overlay covers, but we can add padding if sidebar was fixed/desktop */
  }

  /* Prevenir overflow horizontal global */
  html, body {
    max-width: 100vw;
    overflow-x: hidden;
  }
</style>
