---
// src/layouts/LayoutDashboard.astro
import Footer from "../components/Footer/footer.astro";
import Header from "../components/Header/header.astro";
import { ClientRouter } from "astro:transitions";

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="/css/main.css" />
    <title>{title}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="min-h-screen bg-gray-50 dark:bg-gray-900 font-sans antialiased text-gray-900 dark:text-gray-100">
    <!-- Barrita de carga premium -->
    <div id="global-page-loader" class="fixed top-0 left-0 w-full h-[3px] z-[100] pointer-events-none opacity-0 transition-opacity duration-300">
      <div class="h-full bg-gradient-to-r from-blue-500 via-indigo-500 to-blue-500 w-0 transition-all duration-300 ease-out shadow-[0_0_8px_rgba(59,130,246,0.6)]"></div>
    </div>

    <!-- Header con sidebar incluido -->
    <Header />

    <div class="flex min-h-screen">
      <!-- Espacio reservado para el sidebar en Desktop -->
      <div class="hidden sm:block sm:w-64 flex-shrink-0"></div>

      <!-- Área de Contenido Principal -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <main class="main-content flex-grow p-4 md:p-6 lg:p-8" transition:animate="fade">
          <!-- Contenedor de Toasts -->
          <div id="toast-container" class="fixed top-4 right-4 z-[100] space-y-2"></div>
          
          <!-- Contenido de la página -->
          <slot />
        </main>
        
        <Footer />
      </div>
    </div>

    <script type="module" src="/js/toast.js"></script>
    <script type="module" src="/js/dashboard/dashboardNavigation.js"></script>
  </body>
</html>

<style is:global>
  :root {
    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
  }
  
  body {
    font-family: var(--font-sans);
  }

  /* Animaciones suaves para transiciones de Astro */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.3s;
    animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Ocultar scrollbar innecesario pero permitir scroll */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
