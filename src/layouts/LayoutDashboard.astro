---
import Sidebar from "@components/sidebar/Sidebar";
import Footer from "../components/Footer/footer.astro";
import ToastRoot from "../components/Toast/ToastRoot";
import { ClientRouter } from "astro:transitions";

const { title = "Psicologic", fullscreen = false } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="/css/main.css" />
    <title>{title}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <!--
    body: flex-col
    ├── .layout-shell   (flex-row, flex:1)  ← sidebar-spacer + main
    └── <Footer />                          ← fuera del shell, ancho 100%

    El Sidebar es position:fixed → no afecta al flujo.
    El sidebar-spacer reserva los 232px en el flex-row.
    Como el shell tiene flex:1 y el body es flex-col,
    el footer siempre queda debajo y al 100% del ancho.
  -->
  <body class="layout-body">

    <!-- Progress bar -->
    <div id="global-page-loader" class="progress-bar-root" transition:persist="progress-bar">
      <div class="progress-bar-fill"></div>
    </div>

    <!-- Sidebar fixed — fuera del flujo, no afecta al layout -->
    <Sidebar client:only="react" transition:persist="app-sidebar" />

    <!-- Shell: spacer + contenido -->
    <div class="layout-shell">
      <div class="sidebar-spacer" transition:persist="sidebar-spacer" aria-hidden="true"></div>

      <main class="main-content">
        {fullscreen ? (
          <div class="fullscreen-slot">
            <div id="toast-container" class="toast-container"></div>
            <ToastRoot client:load />
            <slot />
          </div>
        ) : (
          <div class="padded-slot">
            <div id="toast-container" class="toast-container"></div>
            <ToastRoot client:load />
            <slot />
          </div>
        )}
      </main>
    </div>

    <!-- Footer: hermano del shell → ocupa el 100% del ancho del body -->
    {!fullscreen && <Footer />}

  </body>
</html>

<style>
  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
  }

  /* ── Body: flex COLUMN ─────────────────────────
     Apila .layout-shell (crece) y <footer> (fijo abajo).
  ────────────────────────────────────────────────*/
  .layout-body {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    background: #f5f5f9;
  }

  /* ── Shell: flex ROW ───────────────────────────
     flex:1 → ocupa todo el espacio antes del footer.
     El sidebar fixed NO vive aquí; el spacer reserva su hueco.
  ────────────────────────────────────────────────*/
  .layout-shell {
    display: flex;
    flex-direction: row;
    flex: 1;           /* empuja el footer hacia abajo */
    min-height: 0;
  }

  /* Reserva el ancho del sidebar fixed (232px) */
  .sidebar-spacer {
    display: none;
    width: 232px;
    flex-shrink: 0;
  }
  @media (min-width: 640px) {
    .sidebar-spacer { display: block; }
  }

  /* ── Main ──────────────────────────────────────*/
  .main-content {
    flex: 1;
    min-width: 0;
    overflow-x: hidden;
  }

  .padded-slot {
    padding: 24px;
    max-width: 100%;
    position: relative;
  }

  .fullscreen-slot {
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    position: relative;
  }

  /* ── Footer ────────────────────────────────────
     Hijo directo del body flex-col → ancho 100% natural.
     flex-shrink:0 evita que se comprima.
  ────────────────────────────────────────────────*/
  :global(footer) {
    flex-shrink: 0;
    width: 100%;
  }

  /* ── Progress bar ──────────────────────────────*/
  .progress-bar-root {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 3px;
    z-index: 200;
    pointer-events: none;
    opacity: 0;
    transition: opacity .25s;
  }
  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #6366f1, #8b5cf6, #6366f1);
    width: 0;
    transition: width .3s ease-out;
    box-shadow: 0 0 10px rgba(99,102,241,.5);
  }

  /* ── Toast ─────────────────────────────────────*/
  .toast-container {
    position: fixed;
    top: 16px; right: 16px;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>

<script>
  const loader = () => document.getElementById("global-page-loader");
  const bar = () => loader()?.firstElementChild as HTMLElement | null;

  document.addEventListener("astro:before-preparation", () => {
    const l = loader(), b = bar();
    if (!l || !b) return;
    l.style.opacity = "1";
    b.style.width = "60%";
  });

  document.addEventListener("astro:page-load", () => {
    const l = loader(), b = bar();
    if (!l || !b) return;
    b.style.width = "100%";
    setTimeout(() => {
      l.style.opacity = "0";
      setTimeout(() => { b.style.width = "0%"; }, 300);
    }, 150);
  });
</script>