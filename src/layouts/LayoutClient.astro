---
import Footer from "../components/Footer/footer.astro";
import HeaderClient from "../components/Header/headerClient.astro";
import { Analytics } from "@vercel/analytics/react";

import Sidebar from "@components/sidebar/Sidebar";
import Footer from "../components/Footer/footer.astro";
import ToastRoot from "../components/Toast/ToastRoot";
import { ClientRouter } from "astro:transitions";

const { title = "Psicologic", fullscreen = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="stylesheet" href="/css/main.css" />
    <title>{title}</title>
    <ClientRouter />
    <Analytics />
  </head>
  <body>
    <!-- Progress bar — persists across navigations -->
    <div id="global-page-loader" class="progress-bar-root" transition:persist="progress-bar">
      <div class="progress-bar-fill"></div>
    </div>

    <!--
      Sidebar — mounted ONCE, never destroyed by ClientRouter.
      transition:persist with a stable name = Astro keeps this
      exact DOM node alive across ALL page transitions.
      client:only="react" = never SSR'd, avoids hydration mismatch.
    -->
    <Sidebar client:only="react" transition:persist="app-sidebar" />

    <!-- Page shell — only this part swaps on navigation -->
    <div class="layout-shell">
      <!-- Invisible spacer that reserves sidebar width on desktop -->
      <div class="sidebar-spacer" transition:persist="sidebar-spacer" aria-hidden="true"></div>

      <!-- THIS is what ClientRouter replaces on each navigation -->
      <main class="main-content">
        {fullscreen ? (
          <div class="fullscreen-slot">
            <div id="toast-container" class="toast-container"></div>
            <ToastRoot client:load />
            <slot />
          </div>
        ) : (
          <div class="padded-slot">
            <div id="toast-container" class="toast-container"></div>
            <ToastRoot client:load />
            <slot />
          </div>
        )}
      </main>
    </div>

    {!fullscreen && <Footer />}
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: #f5f5f9;
  }

  /* ── Progress bar ── */
  .progress-bar-root {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 3px;
    z-index: 200;
    pointer-events: none;
    opacity: 0;
    transition: opacity .25s;
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #6366f1, #8b5cf6, #6366f1);
    width: 0;
    transition: width .3s ease-out;
    box-shadow: 0 0 10px rgba(99, 102, 241, .5);
  }

  /* ── Shell ── */
  .layout-shell {
    display: flex;
    min-height: 100dvh;
  }

  /* Reserves 232px for the fixed sidebar */
  .sidebar-spacer {
    display: none;
    width: 232px;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .sidebar-spacer { display: block; }
  }

  /* ── Main ── */
  .main-content {
    flex: 1;
    min-width: 0;
    overflow-x: hidden;
  }

  .padded-slot {
    padding: 24px;
    max-width: 100%;
    min-height: 100dvh;
    position: relative;
  }

  .fullscreen-slot {
    width: 100%;
    height: 100dvh;
    overflow: hidden;
    position: relative;
  }

  /* ── Toast ── */
  .toast-container {
    position: fixed;
    top: 16px; right: 16px;
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
</style>

<!-- Progress bar driven by Astro's transition events -->
<script>
  const loader = () => document.getElementById("global-page-loader");
  const bar = () => loader()?.firstElementChild as HTMLElement | null;

  document.addEventListener("astro:before-preparation", () => {
    const l = loader(), b = bar();
    if (!l || !b) return;
    l.style.opacity = "1";
    b.style.width = "60%";
  });

  document.addEventListener("astro:page-load", () => {
    const l = loader(), b = bar();
    if (!l || !b) return;
    b.style.width = "100%";
    setTimeout(() => {
      l.style.opacity = "0";
      setTimeout(() => { b.style.width = "0%"; }, 300);
    }, 150);
  });
</script>