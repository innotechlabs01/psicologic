---
import Footer from "../components/Footer/footer.astro"
import HeaderClient from "../components/Header/headerClient.astro"

const { title } = Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
    	<link rel="stylesheet" href="/css/main.css">
		<title>{title}</title>
	</head>
	<body>
		<HeaderClient />
		<!-- Contenedor principal que respeta el espacio del sidebar -->
		<div class="flex min-h-screen">
		<!-- Espacio reservado para el sidebar (invisible pero mantiene el layout) -->
		<div class="hidden sm:block sm:w-64 flex-shrink-0"></div>
			
			<!-- Contenido principal alineado -->
			<main class="flex-2 w-full sm:w-auto">
				<div class="p-6 max-w-full">
				<div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>
				<script type="module" src="/js/toast.js"></script>
					<slot />
				</div>
			</main>
		</div>
		
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		background: #1e3a8a; /* Fondo azul oscuro */
		color-scheme: dark;
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
