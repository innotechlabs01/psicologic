---
import LayoutClient from '../../layouts/LayoutClient.astro';
import FeedbackForm from '../../components/feedback/FeedbackForm';
import { SignedIn } from '@clerk/astro/components';
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
---

<LayoutClient title="Feedback - Psicologic">
  <SignedIn>
    <DashboardWrapper 
        title="Feedback" 
        subtitle="Envía tu feedback y ayúdanos a mejorar"
    >
      <div className="flex justify-center p-4">
        <FeedbackForm client:visible />
      </div>
    </DashboardWrapper>
  </SignedIn>
</LayoutClient>
