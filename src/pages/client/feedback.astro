---
import LayoutClient from '../../layouts/LayoutClient.astro';
import FeedbackForm from '../../components/feedback/FeedbackForm.tsx';
import { SignedIn } from '@clerk/astro/components';
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
---

<LayoutClient>
  <SignedIn>
    <DashboardWrapper 
        title="Feedback" 
        subtitle="Envía tu feedback y ayudanos a mejorar"
        >
      <div class="min-h-[70vh] flex items-center justify-center p-4 bg-gray-50/50 dark:bg-gray-900/50 rounded-3xl mt-6 relative overflow-hidden">
        <!-- Decoración de fondo sutil -->
        <div class="absolute top-0 right-0 size-96 bg-green-500/5 rounded-full blur-3xl -mr-20 -mt-20"></div>
        <div class="absolute bottom-0 left-0 size-96 bg-indigo-500/5 rounded-full blur-3xl -ml-20 -mb-20"></div>
        
        <FeedbackForm client:visible />
      </div>
    </DashboardWrapper>
  </SignedIn>
</LayoutClient>
