---
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import LayoutClient from '../../layouts/LayoutClient.astro';
import { Show } from "@clerk/astro/components";
import { createClient } from '@libsql/client';

// Configuración de la conexión a Turso
const db = createClient({
    url: import.meta.env.TURSO_DATABASE_URL,
    authToken: import.meta.env.TURSO_AUTH_TOKEN,
});

// --- LÓGICA SSR (SERVER-SIDE RENDERING) PARA VERIFICAR EL TICKET ACTIVO ---

const { userId: clerkUserId } = Astro.locals.auth();

let currentUserId = null;
let currentUserRole = 'usuario_final'; // Valor por defecto
let activeTicketId = null;

// Obtener el ID del ticket de la URL, si está presente (para /chat/TICKET_ID)
const urlTicketId = Astro.params.ticketId; 
let ticketToShowId = urlTicketId;

if (clerkUserId) {
    try {
        // 1. Obtener ID interno (Turso) y Rol del usuario autenticado
        const userResult = await db.execute({
            sql: "SELECT id, role FROM Usuarios WHERE clerk_user_id = ?",
            args: [clerkUserId]
        });
        
        if (userResult.rows.length > 0) {
            const userRecord = userResult.rows[0];
            currentUserId = userRecord.id;
            currentUserRole = String(userRecord.role ?? 'usuario_final');

            // 2. Buscar un ticket 'Abierto' iniciado por este usuario
            const ticketCheck = await db.execute({
                sql: "SELECT ticket_id FROM Tickets WHERE user_id = ? AND estado = 'Abierto'",
                args: [currentUserId]
            });
            
            if (ticketCheck.rows.length > 0) {
                activeTicketId = ticketCheck.rows[0].ticket_id;
            }
        }
    } catch (error) {
        console.error("Error al consultar la BD en SSR:", error);
        // En caso de error, dejamos currentUserId=null para mostrar el botón o pedir iniciar sesión.
    }
}

// 3. Lógica de Redirección y Decisión:

// Si no se proporcionó un ticket ID en la URL, pero el usuario tiene uno activo, redirigir al activo.
if (!urlTicketId && activeTicketId) {
    return Astro.redirect(`/client/chat/${activeTicketId}`);
}

// Determinar el ID final a mostrar: si hay uno en la URL, se usa ese (puede ser cerrado), 
// si no hay URL ID, pero hay activo, se usa el activo.
if (!ticketToShowId && activeTicketId) {
    ticketToShowId = String(activeTicketId);
}

const titleText = ticketToShowId ? `Conversación: ${ticketToShowId.substring(0, 8)}...` : "Iniciar Chat";
---

<LayoutClient title="Asistencia">
    <Show when="signed-in">
        <DashboardWrapper 
            title="Centro de Asistencia" 
            subtitle="¿Cómo podemos ayudarte hoy?"
        >
            <div class="flex flex-col items-center justify-center min-h-[60vh] px-4">
                <div class="max-w-2xl w-full bg-white dark:bg-gray-800 rounded-3xl shadow-xl overflow-hidden border border-gray-100 dark:border-gray-700">
                    <div class="p-8 md:p-12 text-center">
                        <!-- Icono animado o decorativo -->
                        <div class="mb-8 flex justify-center">
                            <div class="p-5 bg-indigo-50 dark:bg-indigo-900/30 rounded-full text-indigo-600 dark:text-indigo-400">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                                </svg>
                            </div>
                        </div>

                        <h3 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4">
                            Soporte Personalizado
                        </h3>
                        <p class="text-gray-600 dark:text-gray-400 text-lg mb-8 leading-relaxed max-w-lg mx-auto">
                            Inicia una conversación con nuestro equipo de soporte para resolver dudas, reportar problemas o recibir asistencia técnica. estamos aquí para apoyarte.
                        </p>

                        <div class="space-y-4">
                            <button 
                                id="iniciar-chat-btn"
                                class="w-full sm:w-auto px-10 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-2xl shadow-lg shadow-indigo-500/30 transition-all duration-300 transform hover:scale-[1.02] active:scale-[0.98] flex items-center justify-center gap-3 mx-auto"
                            >
                                <span id="btn-text">Iniciar Nueva Conversación</span>
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                            </button>

                            <div class="pt-8 border-t border-gray-100 dark:border-gray-700 mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div class="text-center">
                                    <span class="block text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">Horario</span>
                                    <span class="text-gray-900 dark:text-gray-300">24/7 Disponible</span>
                                </div>
                                <div class="text-center">
                                    <span class="block text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">Respuesta</span>
                                    <span class="text-gray-900 dark:text-gray-300">&lt; 15 min prom.</span>
                                </div>
                                <div class="text-center">
                                    <span class="block text-sm font-semibold text-gray-500 uppercase tracking-wider mb-1">Seguridad</span>
                                    <span class="text-gray-900 dark:text-gray-300">Cifrado de punta a punta</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scripts con lógica mejorada -->
            <script is:inline>
                (function() {
                    const btn = document.getElementById('iniciar-chat-btn');
                    const btnText = document.getElementById('btn-text');
                    
                    if (btn) {
                        btn.addEventListener('click', async () => {
                            btn.disabled = true;
                            btn.classList.add('opacity-70', 'cursor-not-allowed');
                            const originalText = btnText.textContent;
                            btnText.textContent = 'Estableciendo conexión...';
                            
                            try {
                                const response = await fetch('/api/tickets/create', { 
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' }
                                });
                                
                                const data = await response.json();
                                
                                if (response.ok || response.status === 409) {
                                    // Guardamos feedback visual antes de redirigir
                                    btnText.textContent = '¡Conectado!';
                                    setTimeout(() => {
                                        window.location.href = `/client/chat/${data.ticket_id}`;
                                    }, 500);
                                } else {
                                    throw new Error(data.error || 'Error desconocido');
                                }
                            } catch (error) {
                                console.error('Chat Error:', error);
                                alert(error.message || 'Hubo un error al iniciar el chat. Por favor intenta de nuevo.');
                                btn.disabled = false;
                                btn.classList.remove('opacity-70', 'cursor-not-allowed');
                                btnText.textContent = originalText;
                            }
                        });
                    }
                })();
            </script>
        </DashboardWrapper>
    </Show>
</LayoutClient>
