---
import LayoutClient from '../../../../layouts/LayoutClient.astro';
import FormRenderer from '../../../../components/Client/history/FormRenderer.jsx';
import { createClient } from '@libsql/client';

const db = createClient({
    url: import.meta.env.TURSO_DATABASE_URL,
    authToken: import.meta.env.TURSO_AUTH_TOKEN,
});

const template = await db.execute({
  sql: "SELECT template FROM template_history WHERE status = true;",
});

if (!template.rows.length) {
  throw new Error("Template no encontrado");
}

const structure = JSON.parse(template.rows[0].template?.toString() || '{}');
const templateId = template.rows[0].id;
---

<LayoutClient title="Formulario de Historia">
  <div class="min-h-[calc(100vh-8rem)] p-4 sm:p-6">
    <FormRenderer structure={structure} templateId={templateId} client:only="react" />
  </div>
</LayoutClient>
