---
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import LayoutClient from '../../layouts/LayoutClient.astro';
import { SignedIn } from "@clerk/astro/components";
// import MercadoPagoCheckoutPro from '../../components/Payment/MercadoPagoCheckoutPro.tsx';

const mercadoPagoCredentials = {
  public_key: process.env.MERCADO_PAGO_PUBLIC_KEY || '',
};

const productData = {
  name: "Example Product",
  price: 100,
  quantity: 1,
  discount: null,
};
---
<LayoutClient title="💳 Payment">
    <SignedIn>
        <DashboardWrapper 
            title="Centro de Pagos" 
            subtitle="Gestiona tu suscripción y revisa el historial de pagos"
        >
        <!-- <MercadoPagoCheckoutPro 
            client:load
            mercado_pago_credentials={mercadoPagoCredentials}
            product_data={productData}
            /> -->
        </DashboardWrapper>
    </SignedIn>
</LayoutClient>


