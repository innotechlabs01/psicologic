---
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import LayoutClient from '../../layouts/LayoutClient.astro';
import { SignedIn } from "@clerk/astro/components";
import UserPaymentDashboard from '../../features/payments/components/UserPaymentDashboard';

const { userId } = Astro.locals.auth();

if (!userId) {
  return Astro.redirect('/login');
}

const response = await fetch(`${Astro.url.origin}/api/epayCO/payment-info`, {
  headers: {
    'Authorization': `Bearer ${userId}`
  }
});

const paymentData = await response.json();
const isGameUser = paymentData?.paymentInfo?.isGameUser === true;
const paymentAmount = isGameUser ? '5000' : '140000';
---

<LayoutClient title="Centro de Pagos - Psicologic">
    <SignedIn>
        <DashboardWrapper 
            title="Centro de Pagos" 
            subtitle="Gestiona tu suscripción y revisa el historial de pagos"
        >
            <UserPaymentDashboard 
                client:load 
                paymentData={paymentData} 
                userId={userId}
                paymentAmount={paymentAmount}
            />
        </DashboardWrapper>
    </SignedIn>
</LayoutClient>
