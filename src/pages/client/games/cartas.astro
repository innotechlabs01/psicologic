---
import CartasGame from "@components/games/cartas";
import DashboardWrapper from "../../../components/Dashboard/DashboardWrapper.astro";
import LayoutClient from "../../../layouts/LayoutClient.astro";
import { Show } from "@clerk/astro/components";
export const prerender = false;
---

<LayoutClient title="🃏 Cartas">
  <Show when="signed-in">
    <DashboardWrapper
      title="🃏 Jugamos"
      subtitle="Anímate a jugar y compartir con tu pareja"
    >

    <CartasGame client:load/>
      
    </DashboardWrapper>
  </Show>
</LayoutClient>

