---
import EmotionsGame from "@components/games/emociones";
import DashboardWrapper from "../../../components/Dashboard/DashboardWrapper.astro";
import LayoutClient from "../../../layouts/LayoutClient.astro";
import { Show } from "@clerk/astro/components";
export const prerender = false;
---

<LayoutClient title="Emociones">
  <Show when="signed-in">
    <DashboardWrapper
      title="Emociones"
      subtitle="Anímate a jugar y descubre cómo las emociones pueden ser divertidas y educativas al mismo tiempo."
    >
    <!-- client:only required: the module injects fonts via document at import time — SSR would crash -->
    <EmotionsGame client:only/>
    </DashboardWrapper>
  </Show>
</LayoutClient>
