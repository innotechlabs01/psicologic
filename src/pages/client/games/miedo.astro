---
import MiedosGame from '@components/games/miedos';
import DashboardWrapper from '../../../components/Dashboard/DashboardWrapper.astro';
import LayoutClient from '../../../layouts/LayoutClient.astro';
import { Show } from '@clerk/astro/components';
export const prerender = false; // Renderizado del lado del cliente
---

<LayoutClient title="🃏 Miedos">
  <Show when="signed-in">
    <DashboardWrapper 
      title="🃏 Jugamos" 
      subtitle="Supera tus miedos"
    >
      <MiedosGame client:load/>
    </DashboardWrapper>
  </Show>
</LayoutClient>

