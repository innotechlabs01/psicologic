---
import { Show } from "@clerk/astro/components";
import LayoutDashboard from "../../layouts/LayoutDashboard.astro";
import DashboardWrapper from "../../components/Dashboard/DashboardWrapper.astro";
import { db } from "../../lib/turso/client";

// Guard admin (patrón de admin/tickets)
const { userId } = Astro.locals.auth();
let isAdmin = false;
if (userId) {
  try {
    const res = await db.execute({
      sql: "SELECT role FROM usuarios WHERE clerk_user_id = ? LIMIT 1",
      args: [userId],
    });
    isAdmin = String(res.rows[0]?.role ?? "") === "org:admin";
  } catch (e) {
    console.error("feedback.astro: error verificando rol", e);
  }
}
---

<LayoutDashboard title="Feedback | Psicologic">
    <Show when="signed-in">
        {isAdmin ? (
            <DashboardWrapper
                title="💬 Feedback"
                subtitle="Lo que dicen los psicólogos sobre la plataforma"
            >
                <div class="mt-6 space-y-8">
                    <!-- Stats -->
                    <div id="feedback-stats" class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 shadow animate-pulse">
                            <div class="h-8 w-16 bg-gray-200 dark:bg-gray-700 rounded"></div>
                        </div>
                        <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 shadow animate-pulse">
                            <div class="h-8 w-24 bg-gray-200 dark:bg-gray-700 rounded"></div>
                        </div>
                        <div class="p-6 rounded-2xl bg-white dark:bg-gray-800 shadow animate-pulse">
                            <div class="h-8 w-20 bg-gray-200 dark:bg-gray-700 rounded"></div>
                        </div>
                    </div>

                    <!-- Chart + cards -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <div class="p-6 bg-white dark:bg-gray-800 rounded-2xl shadow">
                            <h3 class="text-lg font-black text-gray-900 dark:text-white mb-4">
                                Resumen de sentimientos
                            </h3>
                            <canvas id="moodChart"></canvas>
                        </div>
                        <div class="lg:col-span-2">
                            <div id="feedback-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
                            <p id="feedback-empty" class="hidden text-center text-gray-400 py-12">
                                Aún no hay feedback.
                            </p>
                        </div>
                    </div>
                </div>
            </DashboardWrapper>
        ) : (
            <DashboardWrapper title="Feedback" subtitle="">
                <div class="p-12 text-center text-gray-400">
                    No autorizado. Esta sección es solo para administradores.
                </div>
            </DashboardWrapper>
        )}
    </Show>
</LayoutDashboard>

<script>
    import Chart from "chart.js/auto";

    const moodLabels: Record<string, string> = {
        "😠": "Enojado",
        "🙁": "Triste",
        "😐": "Neutral",
        "🙂": "Bien",
        "😊": "Excelente",
    };

    function escapeHtml(s: string) {
        return s.replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&" + "amp;",
                    "<": "&" + "lt;",
                    ">": "&" + "gt;",
                    '"': "&" + "quot;",
                    "'": "&" + "#39;",
                })[c] as string,
        );
    }

    function statCard(label: string, value: string | number) {
        return `<div class="p-6 rounded-2xl bg-white dark:bg-gray-800 shadow">
            <p class="text-xs font-black uppercase tracking-widest text-gray-400">${label}</p>
            <p class="text-3xl font-black text-gray-900 dark:text-white mt-1">${value}</p>
        </div>`;
    }

    async function loadFeedback() {
        try {
            const res = await fetch("/api/feedback/feedback");
            if (!res.ok) {
                console.error("Feedback: error o no autorizado", res.status);
                return;
            }
            const { feedback, stats } = await res.json();

            // Stats
            const statsEl = document.getElementById("feedback-stats");
            if (statsEl) {
                statsEl.innerHTML = `
                    ${statCard("Feedback total", stats.total)}
                    ${statCard("Rating promedio", stats.avgRating)}
                    ${statCard("Últimos 30 días", stats.last30)}
                `;
            }

            // Cards (comentario escapado — input de usuario)
            const grid = document.getElementById("feedback-grid");
            if (grid) {
                grid.innerHTML = feedback
                    .map(
                        (fb: any) => `
                        <div class="p-6 bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-gray-800 dark:to-gray-900 rounded-2xl shadow-sm">
                            <div class="flex items-center justify-between mb-3">
                                <span class="text-3xl">${fb.mood}</span>
                                <span class="font-bold text-indigo-600 dark:text-indigo-400">${fb.rating}/10</span>
                            </div>
                            ${fb.comment ? `<p class="text-gray-700 dark:text-gray-300 text-sm">${escapeHtml(fb.comment)}</p>` : ""}
                            <p class="text-xs text-gray-500 mt-3">${new Date(fb.created_at).toLocaleString("es-CO")}</p>
                        </div>`,
                    )
                    .join("");
            }
            if (!feedback.length) {
                document.getElementById("feedback-empty")?.classList.remove("hidden");
            }

            // Doughnut de moods
            const canvas = document.getElementById("moodChart") as HTMLCanvasElement | null;
            if (canvas && stats.total > 0) {
                new Chart(canvas, {
                    type: "doughnut",
                    data: {
                        labels: Object.keys(stats.byMood).map(
                            (m: string) => `${m} ${moodLabels[m] ?? ""}`.trim(),
                        ),
                        datasets: [
                            {
                                data: Object.values(stats.byMood),
                                backgroundColor: ["#F87171", "#FBBF24", "#94A3B8", "#4ADE80", "#34D399"],
                                borderWidth: 1,
                            },
                        ],
                    },
                    options: {
                        responsive: true,
                        plugins: { legend: { position: "top" } },
                    },
                });
            } else if (canvas) {
                canvas.replaceWith(
                    Object.assign(document.createElement("p"), {
                        className: "text-gray-400 text-sm text-center py-8",
                        textContent: "Sin datos todavía.",
                    }),
                );
            }
        } catch (e) {
            console.error("Feedback: error cargando", e);
        }
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", loadFeedback);
    } else {
        loadFeedback();
    }
</script>
