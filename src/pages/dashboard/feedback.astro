---
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import { SignedIn } from "@clerk/astro/components";
import FeedbackDashboard from '../../components/feedback/FeedbackDashboard';
---

<LayoutDashboard title="💬 Feedback">
  <SignedIn>
    <DashboardWrapper 
      title="Feedback" 
      subtitle="Gestiona todos los feedbacks desde aquí"
    >
      <FeedbackDashboard client:load />
    </DashboardWrapper>
  </SignedIn>
</LayoutDashboard>
