<script>
    import { createClient } from '@libsql/client';
    import Chart from 'chart.js/auto';

    const client = createClient({
        url: import.meta.env.TURSO_DATABASE_URL,
        authToken: import.meta.env.TURSO_AUTH_TOKEN
    });

    async function loadFeedbacks() {
        const { rows } = await client.execute(
            `select * from feedback order by created_at desc`
        );

        if (rows.length === 0) {
            console.error('Error loading feedbacks: No feedbacks found');
            return;
        }

        // Renderizar tarjetas de feedback
        const grid = document.querySelector('.grid-cols-1');
        grid.innerHTML = '';
        rows.forEach(fb => {
            const card = document.createElement('div');
            card.className = 'p-6 bg-gradient-to-br from-blue-50 to-indigo-100 rounded-xl shadow-md hover:shadow-xl transition-shadow duration-300';
            card.innerHTML = `
                <div class="flex items-center mb-4">
                    <span class="text-3xl mr-2">${fb.mood}</span>
                    <span class="font-semibold text-indigo-600">Rating: ${fb.rating}/10</span>
                </div>
                <p class="text-gray-700">${fb.comment}</p>
                <p class="text-sm text-gray-500 mt-2">Fecha: ${new Date(fb.created_at).toLocaleString()}</p>
            `;
            grid.appendChild(card);
        });

        // Gráfico de moods
        const moods = rows.reduce((acc, fb) => {
            acc[fb.mood] = (acc[fb.mood] || 0) + 1;
            return acc;
        }, {});

