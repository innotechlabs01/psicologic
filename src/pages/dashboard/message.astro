---
// =============================================================
// src/pages/admin/tickets/index.astro (Dashboard del Agente)
// =============================================================

import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import { SignedIn } from "@clerk/astro/components";
import { createClient } from '@libsql/client';

// Configuración de la conexión a Turso
const db = createClient({
    url: import.meta.env.TURSO_DATABASE_URL,
    authToken: import.meta.env.TURSO_AUTH_TOKEN,
});

// --- LÓGICA SSR: Autenticación, Autorización y Carga de Datos ---
const { userId: clerkUserId } = Astro.locals.auth();

let currentUserRole = null;
let activeTickets: any[] = [];

if (clerkUserId) {
    try {
        // 1. Obtener ID interno (Turso) y Rol del usuario
        const userResult = await db.execute({
            sql: "SELECT id, role FROM Usuarios WHERE clerk_user_id = ?",
            args: [clerkUserId]
        });

        if (userResult.rows.length > 0) {
            const userRecord = userResult.rows[0];
            currentUserRole = String(userRecord.role ?? 'usuario_final');
        }

        // 2. Comprobación de Rol: Solo Agentes/Admin pueden acceder
        const isAgentAuthorized = currentUserRole === 'agente_soporte' || currentUserRole === 'org:admin';

        if (!isAgentAuthorized) {
            // Si el usuario está logueado pero no es agente, lo redirige al dashboard de cliente
            return Astro.redirect('/dashboard'); 
        }

        // 3. Obtener la lista de todos los tickets activos (Open)
        const ticketsResult = await db.execute({
            sql: `
                SELECT 
                    T.ticket_id, 
                    T.fecha_creacion, 
                    U.name AS user_name,
                    T.last_message_preview -- Asumiendo que esta columna existe
                FROM Tickets T 
                JOIN Usuarios U ON T.user_id = U.id 
                WHERE T.estado = 'Abierto' 
                ORDER BY T.fecha_creacion DESC
            `,
            args: []
        });

        // Mapear los resultados a un formato usable
        activeTickets = ticketsResult.rows.map(row => ({
            id: row.ticket_id,
            userName: row.user_name,
            fecha: row.fecha_creacion ? new Date(String(row.fecha_creacion)).toLocaleString() : '',
            preview: row.last_message_preview || "Inició un nuevo chat",
        }));
        
    } catch (error) {
        console.error("Error al consultar la BD en SSR (Admin Dashboard):", error);
        // En caso de error, la lista de tickets quedará vacía.
    }
} else {
    // Si no está logueado en Clerk, redirige al login del admin
    return Astro.redirect('/');
}
---

<LayoutDashboard title="💼 Panel de Tickets Activos">
    <SignedIn>
        <DashboardWrapper 
        title="Tickets Activos" 
        subtitle={`Total: ${activeTickets.length} conversaciones abiertas`}
        >
            <div class="flex h-[75vh] bg-white dark:bg-gray-800 rounded-xl shadow-xl overflow-hidden">
                
                {/* 1. Panel Lateral de Conversaciones (Lista de Chats) */}
                <div class="w-1/4 border-r dark:border-gray-700 overflow-y-auto bg-gray-50 dark:bg-gray-700">
                    <h3 class="sticky top-0 p-4 text-lg font-semibold text-gray-800 dark:text-gray-100 border-b dark:border-gray-700 bg-gray-50 dark:bg-gray-700">
                        Conversaciones ({activeTickets.length})
                    </h3>

                    {activeTickets.length === 0 ? (
                        <div class="p-4 text-center text-gray-500 dark:text-gray-400">
                            No hay tickets activos en este momento.
                        </div>
                    ) : (
                        activeTickets.map(ticket => (
                            <a 
                                href={`/admin/tickets/${ticket.id}`} 
                                class="flex items-center p-4 border-b dark:border-gray-700 hover:bg-indigo-100 dark:hover:bg-indigo-900 transition duration-150 cursor-pointer"
                                aria-label={`Abrir chat con ${ticket.userName}`}
                            >
                                <div class="flex-shrink-0 w-10 h-10 bg-indigo-500 dark:bg-indigo-400 rounded-full flex items-center justify-center text-white text-lg font-bold mr-3">
                                    {ticket.userName.charAt(0)}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex justify-between items-center">
                                        <p class="font-bold text-gray-900 dark:text-gray-100 truncate">{ticket.userName}</p>
                                        <span class="text-xs text-gray-500 dark:text-gray-400">{new Date(ticket.fecha).toLocaleDateString()}</span>
                                    </div>
                                    <p class="text-sm text-gray-600 dark:text-gray-300 truncate mt-1">
                                        {ticket.preview}
                                    </p>
                                </div>
                            </a>
                        ))
                    )}
                </div>

                {/* 2. Área de Contenido Principal (Vista Inicial) */}
                <div class="flex-1 flex flex-col items-center justify-center p-8 text-center">
                    <svg class="w-20 h-20 text-indigo-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
                    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
                        Selecciona una Conversación
                    </h2>
                    <p class="text-gray-600 dark:text-gray-400">
                        Haz clic en un ticket de la izquierda para comenzar a responder los mensajes.
                    </p>
                </div>
            </div>
        </DashboardWrapper>
    </SignedIn>
</LayoutDashboard>
