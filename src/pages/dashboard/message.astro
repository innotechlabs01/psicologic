---
// =============================================================
// src/pages/admin/tickets/index.astro (Dashboard del Agente)
// =============================================================

import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import { SignedIn } from "@clerk/astro/components";
import ChatInterface from '../../features/chat/components/ChatInterfaceAdmin.jsx';
import { db } from '../../lib/turso/client';

// 🇪🇸 Formato dd/mm/yyyy
const formattedDate = (date: number) => {
    const newDate = new Date(date);
    return newDate.toLocaleDateString('en-US', { 
        day: '2-digit', 
        month: '2-digit', 
        year: 'numeric' 
    });
};

// --- LÓGICA SSR: Autenticación, Autorización y Carga de Datos ---
const { userId: clerkUserId } = Astro.locals.auth();

let currentUserRole = null;
let currentUserId = null;
let activeTickets: any[] = [];

if (clerkUserId) {
    try {
        // 1. Obtener ID interno (Turso) y Rol del usuario
        const userResult = await db.execute({
            sql: "SELECT id, role FROM Usuarios WHERE clerk_user_id = ?",
            args: [clerkUserId]
        });

        if (userResult.rows.length > 0) {
            const userRecord = userResult.rows[0];
            currentUserRole = String(userRecord.role ?? 'usuario_final');
            currentUserId = userRecord.id;
        }

        
        // 2. Comprobación de Rol: Solo Agentes/Admin pueden acceder
        const isAgentAuthorized = currentUserRole === 'agente_soporte' || currentUserRole === 'org:admin';

        if (!isAgentAuthorized) {
            // Si el usuario está logueado pero no es agente, lo redirige al dashboard de cliente
            return Astro.redirect('/dashboard'); 
        }

        // 3. Obtener la lista de todos los tickets activos (Open)
        const ticketsResult = await db.execute({
            sql: `
                SELECT 
                    T.ticket_id, 
                    T.fecha_creacion, 
                    U.username AS user_name
                FROM Tickets T 
                JOIN Usuarios U ON T.user_id = U.id 
                WHERE T.estado = 'Abierto' 
                ORDER BY T.fecha_creacion DESC
            `,
            args: []
        });

        

        // Mapear los resultados a un formato usable
        activeTickets = ticketsResult.rows.map((row: any) => ({
            id: row.ticket_id,
            userName: row.user_name,
            fecha: row.fecha_creacion ? formattedDate(parseInt(row.fecha_creacion?.toString() || '0')) : '',
            preview: row.last_message_preview || "Inició un nuevo chat",
        }));
        
    } catch (error) {
        console.error("Error al consultar la BD en SSR (Admin Dashboard):", error);
        // En caso de error, la lista de tickets quedará vacía.
    }
} else {
    // Si no está logueado en Clerk, redirige al login del admin
    return Astro.redirect('/');
}
---

<LayoutDashboard title="💼 Panel de Tickets Activos">
    <SignedIn>
        <DashboardWrapper 
        title="Tickets Activos" 
        subtitle={`Total: ${activeTickets.length} conversaciones abiertas`}
        >
            <div class="flex h-[75vh] bg-card text-card-foreground rounded-xl shadow-xl overflow-hidden border border-border">
                
                {/* 1. Panel Lateral de Conversaciones (Lista de Chats) */}
                <div class="w-1/4 border-r border-border overflow-y-auto bg-muted">
                    <h3 class="sticky top-0 p-4 text-lg font-semibold text-foreground border-b border-border bg-muted">
                        Conversaciones ({activeTickets.length})
                    </h3>

                    {activeTickets.length === 0 ? (
                        <div class="p-4 text-center text-muted-foreground">
                            No hay tickets activos en este momento.
                        </div>
                    ) : (
                        activeTickets.map(ticket => (
                            <a 
                                href="#" 
                                data-ticket-id={ticket.id}
                                data-user-name={ticket.userName}
                                class="ticket-link ticket-item flex items-center p-4 border-b border-border hover:bg-accent transition duration-150 cursor-pointer"
                                aria-label={`Abrir chat con ${ticket.userName}`}
                            >
                                <div class="flex-shrink-0 w-10 h-10 bg-primary rounded-full flex items-center justify-center text-primary-foreground text-lg font-bold mr-3">
                                    {ticket.userName.charAt(0)}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex justify-between items-center">
                                        <p class="font-bold text-foreground truncate">{ticket.userName}</p>
                                        <span class="text-xs text-muted-foreground">{ticket.fecha}</span>
                                    </div>
                                    <p class="text-sm text-muted-foreground truncate mt-1">
                                        {ticket.preview}
                                    </p>
                                </div>
                            </a>
                        ))
                    )}
                </div>

                {/* 2. ÁREA DE CONTENIDO PRINCIPAL (CONTROLADA POR REACT) */}
                <div class="flex-1 flex flex-col p-0" id="chat-content-area">
                    
                    {/* Renderizamos el componente de React aquí. */}
                    {currentUserRole && (
                        <ChatInterface
                            currentUserId={currentUserId}
                            currentUserRole={currentUserRole}
                            client:only="react" 
                         />
                    )}
                </div>
            </div>
        </DashboardWrapper>
    </SignedIn>
</LayoutDashboard>

<!-- 3. SCRIPT DE CLIENTE (El "pegamento" que comunica Astro con React) -->
<script type="module">
    // Seleccionamos todos los enlaces de tickets
    const ticketLinks = document.querySelectorAll('.ticket-link');
    const dashboardWrapper = document.getElementById('dashboard-wrapper');
    const titleEl = dashboardWrapper?.querySelector('h1'); 
    const subtitleEl = dashboardWrapper?.querySelector('h1 + p');
    
    // Función para activar visualmente el chat y notificar a React
    const activateChat = (ticketId, userName) => {
        // Actualiza el título y subtítulo del DashboardWrapper (Astro)
        if (titleEl) titleEl.textContent = `Chat: ${userName}`;
        if (subtitleEl) subtitleEl.textContent = `Ticket ID: ${ticketId.substring(0, 8)}...`;
        
        // Remueve la selección de todos los tickets y selecciona el actual
        document.querySelectorAll('.ticket-item').forEach(link => 
            link.classList.remove('bg-accent')
        );
        const activeLink = document.querySelector(`[data-ticket-id="${ticketId}"]`);
        if (activeLink) {
            activeLink.classList.add('bg-accent');
        }

        // 🔔 Evento de notificación a React
        // El componente ChatInterfaceAdmin.jsx está escuchando este evento
        document.dispatchEvent(new CustomEvent('ticketSelected', {
            detail: { 
                ticketId,
                userName,
            }
        }));
    };

    // Manejador de click en los enlaces de tickets
    ticketLinks.forEach(link => {
        link.addEventListener('click', (e) => {
            e.preventDefault();
            const ticketId = link.dataset.ticketId;
            const userName = link.dataset.userName;
            
            if (ticketId && userName) {
                // Actualiza la URL sin recargar la página
                history.pushState(null, '', `?ticketId=${ticketId}`);
                activateChat(ticketId, userName);
            }
        });
    });

    // Cargar ticket inicial si existe en la URL (al cargar la página)
    const urlParams = new URLSearchParams(window.location.search);
    const initialTicketId = urlParams.get('ticketId');
    if (initialTicketId) {
        const link = document.querySelector(`[data-ticket-id="${initialTicketId}"]`);
        if (link) {
            const userName = link.dataset.userName;
            // Damos un pequeño tiempo para que React se inicialice (solo por seguridad)
            setTimeout(() => {
                activateChat(initialTicketId, userName);
            }, 100);
        }
    }
</script>