---
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import { Show } from "@clerk/astro/components";
import { PaymentsCRM } from '../../components/Admin/PaymentsCRM';
---

<LayoutDashboard title="Pagos y Membresías | Psicologic">
  <Show when="signed-in">
    <DashboardWrapper
      title="Pagos y Membresías"
      subtitle="Ingresos diarios/mensuales, vencimientos por psicólogo e historial de transacciones"
    >
      <PaymentsCRM client:load />
    </DashboardWrapper>
  </Show>
</LayoutDashboard>
