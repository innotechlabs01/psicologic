---
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import { Show } from "@clerk/astro/components";
import { SettingsCRM } from '../../components/Admin/SettingsCRM';
import { db } from '../../lib/turso/client';

const { userId } = Astro.locals.auth();
let adminName = 'Administrador';
let adminEmail = '';

if (userId) {
  try {
    const res = await db.execute({
      sql: 'SELECT first_name, last_name, email FROM usuarios WHERE clerk_user_id = ? LIMIT 1',
      args: [userId],
    });
    const row = res.rows[0] as any;
    if (row) {
      adminName = [row.first_name, row.last_name].filter(Boolean).join(' ').trim() || 'Administrador';
      adminEmail = String(row.email || '');
    }
  } catch {
    // non-fatal
  }
}
---

<LayoutDashboard title="Configuración y Módulos | Psicologic">
  <Show when="signed-in">
    <DashboardWrapper
      title="Configuración y Módulos"
      subtitle="Activa, modifica o desactiva opciones por psicólogo en tiempo real"
    >
      <SettingsCRM adminName={adminName} adminEmail={adminEmail} client:load />
    </DashboardWrapper>
  </Show>
</LayoutDashboard>
