---
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import { SignedIn } from "@clerk/astro/components";

---

<LayoutDashboard title="🔒 Dashboard - ⚙️ Configuraciones">
  <SignedIn>
    <DashboardWrapper 
      title="Configuraciones" 
      subtitle="Personaliza tu experiencia en la plataforma"
    >
      <div class="space-y-6">
        <!-- Formulario de configuraciones -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <!-- Menú de navegación lateral -->
          <div class="bg-card rounded-lg shadow-sm p-6 border border-border h-fit">
            <nav class="space-y-2">
              <!-- <a href="#perfil" data-section="perfil" class="block px-3 py-2 rounded-md bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 font-medium active-section">
                👤 Perfil
              </a> -->
              <a href="#juegos" data-section="juegos" class="block px-3 py-2 rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors">
                🎮 Juegos
              </a>
              <a href="#seguridad" data-section="seguridad" class="block px-3 py-2 rounded-md text-muted-foreground hover:bg-accent hover:text-accent-foreground transition-colors">
                🔒/🔓 Asociar juego al ususario
              </a>
              <!-- <a href="#preferencias" data-section="preferencias" class="block px-3 py-2 rounded-md text-foreground dark:text-gray-300 hover:bg-muted/50 dark:hover:bg-gray-700">
                🔧 Preferencias
              </a>
              <a href="#notificaciones" data-section="notificaciones" class="block px-3 py-2 rounded-md text-foreground dark:text-gray-300 hover:bg-muted/50 dark:hover:bg-gray-700">
                🔔 Notificaciones
              </a>
              <a href="#privacidad" data-section="privacidad" class="block px-3 py-2 rounded-md text-foreground dark:text-gray-300 hover:bg-muted/50 dark:hover:bg-gray-700">
                🛡️ Privacidad
              </a> -->
            </nav>
          </div>
          
          <!-- Contenido principal -->
          <div class="lg:col-span-2 space-y-6">
            
            <!-- Perfil -->
            <div id="perfil" data-section="perfil" class="bg-card rounded-lg shadow-sm p-6 border border-border">
              <h2 class="text-xl font-semibold text-foreground mb-4">
                Información del Perfil
              </h2>
              <form class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-foreground dark:text-gray-300 mb-1">
                      Nombre
                    </label>
                    <input 
                      type="text" 
                      value="Juan" 
                      class="w-full px-3 py-2 border border-input bg-background text-foreground rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    >
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-foreground dark:text-gray-300 mb-1">
                      Apellido
                    </label>
                    <input 
                      type="text" 
                      value="Díaz" 
                      class="w-full px-3 py-2 border border-input bg-background text-foreground rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    >
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-medium text-foreground dark:text-gray-300 mb-1">
                    Email
                  </label>
                  <input 
                    type="email" 
                    value="juan@ejemplo.com" 
                    class="w-full px-3 py-2 border border-input bg-background text-foreground rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                  >
                </div>
                <div>
                  <label class="block text-sm font-medium text-foreground dark:text-gray-300 mb-1">
                    Biografía
                  </label>
                  <textarea 
                    rows="3" 
                    class="w-full px-3 py-2 border border-input bg-background text-foreground rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                    placeholder="Cuéntanos sobre ti..."
                  ></textarea>
                </div>
                <div class="flex justify-end">
                  <button 
                    type="submit" 
                    class="bg-primary hover:bg-primary/90 text-primary-foreground px-6 py-2 rounded-lg font-medium transition-colors"
                  >
                    Guardar Cambios
                  </button>
                </div>
              </form>
            </div>
            
            <!-- Seguridad -->
            <div id="seguridad" data-section="seguridad" class="bg-card rounded-lg shadow-sm p-6 border border-border hidden">
              <h2 class="text-xl font-semibold text-foreground mb-4">
                🔓/🔒 Activar-Desactivar Modulos x Usuarios
              </h2>
              <div id="treeContainer" class="tree-root mt-4"></div>
            </div>
            
            <!-- Notificaciones -->
            <div id="notificaciones" data-section="notificaciones" class="bg-card rounded-lg shadow-sm p-6 border border-border hidden">
              <h2 class="text-xl font-semibold text-foreground mb-4">
                Notificaciones
              </h2>
              <p class="text-muted-foreground dark:text-muted-foreground">
                Personaliza tus preferencias de notificaciones.
              </p>
            </div>
            
            <!-- Privacidad -->
            <div id="privacidad" data-section="privacidad" class="bg-card rounded-lg shadow-sm p-6 border border-border hidden">
              <h2 class="text-xl font-semibold text-foreground mb-4">
                Privacidad
              </h2>
              <p class="text-muted-foreground dark:text-muted-foreground">
                Ajusta la configuración de privacidad de tu cuenta.
              </p>
            </div>
            
            <!-- Juegos -->
            <div id="juegos" data-section="juegos" class="bg-card rounded-lg shadow-sm p-6 border border-border hidden">
              <h2 class="text-xl font-semibold text-foreground mb-4">
                Juegos - Creación
              </h2>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-foreground dark:text-gray-300 mb-1">
                    Slug
                  </label>
                  <input 
                    id="txtSlugGame"
                    type="text" 
                    placeholder="Ingresa el slug del juego" 
                    class="w-full px-3 py-2 border border-input bg-background text-foreground rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                  >
                </div>
                <div>
                  <label class="block text-sm font-medium text-foreground dark:text-gray-300 mb-1">
                    Nombre del juego
                  </label>
                  <input 
                    id="txtNameGame"
                    type="text" 
                    placeholder="Ingresa el nombre del juego" 
                    class="w-full px-3 py-2 border border-input bg-background text-foreground rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                  >
                </div>
                <div>
                  <label class="block text-sm font-medium text-foreground dark:text-gray-300 mb-1">
                    Descripción
                  </label>
                  <textarea 
                    id="txtDescriptionGame"
                    rows="3" 
                    placeholder="Ingresa una descripción del juego" 
                    class="w-full px-3 py-2 border border-input bg-background text-foreground rounded-lg focus:outline-none focus:ring-2 focus:ring-primary"
                  ></textarea>
                </div>
                <div>
                  <button 
                    id="btnIdGame"
                    class="bg-primary hover:bg-primary/90 text-primary-foreground px-6 py-2 rounded-lg font-medium transition-colors"
                  >
                    Crear Juego
                  </button>
                </div>
                <!-- Spinner -->
                <div class="flex justify-end">
                  <div id="spinnerGame" class="mt-2 hidden">
                    <svg class="animate-spin h-5 w-5 text-blue-500 mx-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                  </div>
                  <p class="text-sm text-blue-500 text-center mt-1">Creando juego...</p>
                </div>
              </div>
            </div>
            
            <!-- Preferencias -->
            <div id="preferencias" data-section="preferencias" class="bg-card rounded-lg shadow-sm p-6 border border-border hidden">
              <h2 class="text-xl font-semibold text-foreground mb-4">
                Preferencias
              </h2>
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-medium text-foreground dark:text-white">Modo oscuro</h3>
                    <p class="text-sm text-muted-foreground dark:text-muted-foreground">Cambiar el tema de la aplicación</p>
                  </div>
                  <button class="relative inline-flex h-6 w-11 items-center rounded-full bg-gray-200 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-600">
                    <span class="inline-block h-4 w-4 transform rounded-full bg-card transition-transform translate-x-1"></span>
                  </button>
                </div>
                <div class="flex items-center justify-between">
                  <div>
                    <h3 class="font-medium text-foreground dark:text-white">Notificaciones por email</h3>
                    <p class="text-sm text-muted-foreground dark:text-muted-foreground">Recibir actualizaciones por correo</p>
                  </div>
                  <button class="relative inline-flex h-6 w-11 items-center rounded-full bg-blue-500 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <span class="inline-block h-4 w-4 transform rounded-full bg-card transition-transform translate-x-6"></span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      
    </DashboardWrapper>
  </SignedIn>
    <script type="module" src="/js/settings.js"></script>
    <script type="module" src="/src/utils/toast.js"></script>
</LayoutDashboard>