---
// src/pages/dashboard/settings.astro
import DashboardWrapper from '../../components/Dashboard/DashboardWrapper.astro';
import LayoutDashboard from '../../layouts/LayoutDashboard.astro';
import { SignedIn } from "@clerk/astro/components";

---

<LayoutDashboard title="🔒 Dashboard - ⚙️ Configuraciones">
  <SignedIn>
    <DashboardWrapper 
      title="Configuraciones" 
      subtitle="Personaliza tu experiencia en la plataforma"
    >
      <div class="space-y-6">
        <!-- Formulario de configuraciones -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <!-- Menú de navegación lateral -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700 h-fit">
            <nav class="space-y-2">
              <a href="#perfil" data-section="perfil" class="block px-3 py-2 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">
                👤 Perfil
              </a>
              <a href="#juegos" data-section="juegos" class="block px-3 py-2 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">
                🎮 Juegos
              </a>
              <a href="#seguridad" data-section="seguridad" class="block px-3 py-2 rounded-md text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-700">
                🔒/🔓 Usuarios
              </a>
            </nav>
          </div>
          
          <!-- Contenido principal -->
          <div class="lg:col-span-2 space-y-6">
            
            <!-- Perfil -->
            <div id="perfil" data-section="perfil" class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700">
              <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
                Información del Perfil
              </h2>
              <form class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                      Nombre
                    </label>
                    <input 
                      type="text" 
                      value="Juan" 
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                    >
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                      Apellido
                    </label>
                    <input 
                      type="text" 
                      value="Díaz" 
                      class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                    >
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Email
                  </label>
                  <input 
                    type="email" 
                    value="juan@ejemplo.com" 
                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  >
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Biografía
                  </label>
                  <textarea 
                    rows="3" 
                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                    placeholder="Cuéntanos sobre ti..."
                  ></textarea>
                </div>
                <div class="flex justify-end">
                  <button 
                    type="submit" 
                    class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg font-medium"
                  >
                    Guardar Cambios
                  </button>
                </div>
              </form>
            </div>
            
            <!-- Seguridad -->
            <div id="seguridad" data-section="seguridad" class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700 hidden">
              <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
                🔓/🔒 Activar-Desactivar Modulos x Usuarios
              </h2>
              <div id="treeContainer" class="tree-root mt-4"></div>
            </div>

             <!-- Juegos -->
             <div id="juegos" data-section="juegos" class="bg-white dark:bg-gray-800 rounded-lg shadow-sm p-6 border border-gray-200 dark:border-gray-700 hidden">
              <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">
                Juegos - Creación
              </h2>
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Slug
                  </label>
                  <input 
                    id="txtSlugGame"
                    type="text" 
                    placeholder="Ingresa el slug del juego" 
                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  >
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Nombre del juego
                  </label>
                  <input 
                    id="txtNameGame"
                    type="text" 
                    placeholder="Ingresa el nombre del juego" 
                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  >
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                    Descripción
                  </label>
                  <textarea 
                    id="txtDescriptionGame"
                    rows="3" 
                    placeholder="Ingresa una descripción del juego" 
                    class="w-full px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:text-white"
                  ></textarea>
                </div>
                <div class="flex items-center gap-3">
                  <button 
                    id="btnIdGame"
                    class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg font-medium transition-colors"
                  >
                    Crear Juego
                  </button>
                  <div id="spinnerGame" class="hidden">
                    <svg class="animate-spin h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </DashboardWrapper>
  </SignedIn>

  <script>
    function setupSettings() {
      const activeClasses = ['bg-indigo-50', 'dark:bg-indigo-900/30', 'text-indigo-600', 'dark:text-indigo-400', 'font-medium', 'active-section'];
      const inactiveClasses = ['text-gray-700', 'dark:text-gray-300', 'hover:bg-gray-50', 'dark:hover:bg-gray-700'];

      const navLinks = document.querySelectorAll('nav a[data-section]');
      const contentSections = document.querySelectorAll('.lg\\:col-span-2 > div[data-section]');

      const switchSection = (sectionId: string) => {
          contentSections.forEach((section) => section.classList.add('hidden'));
          navLinks.forEach((link) => {
              link.classList.remove(...activeClasses);
              link.classList.add(...inactiveClasses);
          });

          const targetSection = document.getElementById(sectionId);
          if (targetSection) targetSection.classList.remove('hidden');

          const activeLink = document.querySelector(`nav a[data-section="${sectionId}"]`);
          if (activeLink) {
              activeLink.classList.remove(...inactiveClasses);
              activeLink.classList.add(...activeClasses);
          }
      };

      navLinks.forEach((link) => {
          link.addEventListener('click', (e) => {
              e.preventDefault();
              const target = e.currentTarget as HTMLElement;
              const sectionId = target.getAttribute('data-section');
              if (sectionId) switchSection(sectionId);
          });
      });

      // Initialize with default section
      switchSection('perfil');

      // Initialize Tree logic if container exists
      const treeContainer = document.getElementById('treeContainer');
      if (treeContainer) {
          // You might want to re-import or re-run the tree initialization here
          // For now, let's just make sure the switch panel works
      }
    }

    document.addEventListener("astro:page-load", setupSettings);
  </script>
</LayoutDashboard>