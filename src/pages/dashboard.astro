---
import LayoutDashboard from "../layouts/LayoutDashboard.astro";
import { Show } from "@clerk/astro/components";
import { MyLine } from "../components/Chartjs/chart.tsx";
import { PsychologistCRM } from "../components/Admin/PsychologistCRM";
---

<LayoutDashboard title="CRM Admin | Psicologic">
  <Show when="signed-in">
    <div class="min-h-screen bg-gray-50/50 dark:bg-gray-950 pb-12">
      <!-- Header Seccion -->
      <div class="relative bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800 overflow-hidden">
        <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-indigo-500/5 blur-[120px] rounded-full -mr-48 -mt-48"></div>
        <div class="absolute bottom-0 left-0 w-[300px] h-[300px] bg-blue-500/5 blur-[100px] rounded-full -ml-24 -mb-24"></div>

        <main class="max-w-7xl mx-auto px-4 sm:px-6 py-8 md:py-10 relative">
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div class="space-y-2">
              <div class="flex items-center gap-2 mb-2">
                <span class="px-2.5 py-0.5 bg-indigo-100 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 text-[10px] font-black uppercase tracking-widest rounded-md">
                  Admin CRM
                </span>
                <div class="flex items-center gap-1.5 text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  Datos en tiempo real
                </div>
              </div>
              <h1 class="text-2xl sm:text-3xl md:text-4xl font-black text-gray-900 dark:text-white tracking-tighter leading-none">
                Panel de Seguimiento CRM
              </h1>
              <p class="text-gray-500 dark:text-gray-400 text-sm sm:text-base font-medium max-w-xl">
                Control de psicólogos, actividad clínica agregada, renovaciones y soporte desde un solo lugar.
              </p>
            </div>

            <div class="flex flex-wrap gap-3">
              <a
                href="/admin/users"
                class="px-5 py-2.5 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-xl text-sm font-bold text-gray-700 dark:text-gray-300 shadow-sm hover:shadow-md transition-all"
              >
                Aprobaciones
              </a>
              <a
                href="/dashboard/message"
                class="px-5 py-2.5 bg-indigo-600 dark:bg-indigo-500 text-white rounded-xl text-sm font-bold shadow-lg shadow-indigo-200 dark:shadow-none hover:bg-indigo-700 transition-all"
              >
                Tickets y Mensajes
              </a>
            </div>
          </div>
        </main>
      </div>

      <main class="max-w-7xl mx-auto px-4 sm:px-6 pt-6 space-y-8 relative">
        <!-- CRM KPIs, Alertas y Seguimiento de Psicólogos -->
        <PsychologistCRM client:load />

        <!-- Tendencia de Actividad -->
        <div class="bg-white dark:bg-gray-900 rounded-2xl p-5 sm:p-7 border border-gray-100 dark:border-gray-800 shadow-sm">
          <div class="flex items-center justify-between mb-6">
            <div>
              <h2 class="text-lg font-black text-gray-900 dark:text-white tracking-tight">Actividad de la Plataforma</h2>
              <p class="text-xs font-medium text-gray-500">Evolución de registros y sesiones</p>
            </div>
          </div>
          <div class="min-h-[260px] sm:min-h-[320px]">
            <MyLine client:idle />
          </div>
        </div>
      </main>
    </div>
  </Show>
</LayoutDashboard>

<style>
  @keyframes entry {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  main {
    animation: entry 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
</style>
