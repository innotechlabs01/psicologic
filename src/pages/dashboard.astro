---
import DashboardWrapper from "../components/Dashboard/DashboardWrapper.astro";
import LayoutDashboard from "../layouts/LayoutDashboard.astro";
import { SignedIn } from "@clerk/astro/components";
import { MyLine } from "../components/Chartjs/chart.tsx";

import { DashboardStats } from "../features/dashboard/components/DashboardStats.tsx";

// SSR Data Fetching removed to favor client-side skeletons for stats
---

<LayoutDashboard title="🔒 Dashboard">
  <SignedIn>
    <DashboardWrapper
      title="Dashboard Principal"
      subtitle="Bienvenido a tu panel de control"
    >
      <!-- Contenido principal del dashboard -->
      <div class="space-y-6">
        <DashboardStats client:visible />
      </div>
      <div
        class="bg-card dark:bg-gray-800 rounded-lg shadow-sm p-6 border border-border dark:border-gray-700"
      >
        <MyLine client:visible />
      </div>
    </DashboardWrapper>
  </SignedIn>
</LayoutDashboard>
