---
import LayoutClient from "../layouts/LayoutClient.astro";
import { SignedIn } from "@clerk/astro/components";
import DashboardWrapper from "../components/Dashboard/DashboardWrapper.astro";
import AppointmentsChart from "../components/Chartjs/AppointmentsChart";
import { format, subMonths } from "date-fns";
import { getPendingAppointmentsCount, getConfirmedAppointmentsCount, getTotalAppointmentsCount, getEventsByDateRange, getNextAppointment } from "../lib/turso/agenda/agenda-db";

const { userId } = Astro.locals.auth();

console.log('User ID from auth:', userId);

let pendingCount = 0;
let confirmedCount = 0;
let appointmentsData: any[] = [];
let nextAppointment: any = null;

if (userId) {
  const today = format(new Date(), 'yyyy-MM-dd');
  const oneYearAgo = format(subMonths(new Date(), 12), 'yyyy-MM-dd');
  
  console.log('Today date:', today);
  console.log('Getting appointments from:', oneYearAgo, 'to:', today);
  
  pendingCount = await getPendingAppointmentsCount(userId, today);
  confirmedCount = await getConfirmedAppointmentsCount(userId, today);
  const totalCount = await getTotalAppointmentsCount(userId);
  
  // Obtener historial completo para el gráfico - IGUAL A LAS TARJETAS
  appointmentsData = await getEventsByDateRange(oneYearAgo, today, userId);
  
  // Obtener la próxima cita confirmada
  nextAppointment = await getNextAppointment(userId);
  
  console.log('Pending count:', pendingCount);
  console.log('Confirmed count:', confirmedCount);
  console.log('Total count:', totalCount);
  console.log('Appointments for chart:', appointmentsData.length);
  console.log('Next appointment details:', {
    found: nextAppointment !== null,
    title: nextAppointment?.title,
    date: nextAppointment?.date,
    startTime: nextAppointment?.startTime,
    status: nextAppointment?.status
  });
} else {
  console.log('No userId found');
}
---

