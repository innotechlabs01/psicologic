---
import LayoutClient from '../layouts/LayoutClient.astro'
import { Show } from "@clerk/astro/components";
import DashboardWrapper from '../components/Dashboard/DashboardWrapper.astro';
---

<LayoutClient title=" 🔒 Client">
	<Show when="signed-in">
		<DashboardWrapper title="Área de Cliente"
	subtitle="Bienvenido a tu área de cliente">


		<main class="max-w-xl mx-auto py-12">
			<h1 class="text-black text-3xl font-bold dark:text-black"> Tus retos Client</h1>
			<p class="text-black dark:text-black mt-4">Bienvenido a tu área personal. Aquí podrás ver y gestionar tus retos.</p>
		</main>

		</DashboardWrapper>
	</Show>
</LayoutClient>
