---
// pages/agenda/confirm.astro
import LayoutVideoCall from "../../layouts/LayoutVideoCall.astro";
import { getEventByToken, confirmEvent } from "../../lib/turso/agenda/agenda-db";


const token = Astro.url.searchParams.get("token");

if (!token) {
    return Astro.redirect("/agenda");
}

const event = await getEventByToken(token);

if (!event) {
    return Astro.redirect("/agenda?error=invalid_token");
}

 await confirmEvent(token);
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cita Confirmada – Psicologic</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --violet: #7c3aed;
            --violet-light: #ede9fe;
            --green: #22c55e;
            --green-light: #dcfce7;
            --text: #1e1b2e;
            --muted: #6b7280;
            --surface: #ffffff;
            --bg: #f5f3ff;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        /* Fondo decorativo */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse 80% 60% at 20% 10%, #ddd6fe55 0%, transparent 60%),
                radial-gradient(ellipse 60% 50% at 80% 90%, #bbf7d055 0%, transparent 60%);
            pointer-events: none;
        }

        .card {
            background: var(--surface);
            border-radius: 24px;
            padding: 52px 44px;
            max-width: 480px;
            width: 100%;
            box-shadow:
                0 4px 24px rgba(124, 58, 237, 0.08),
                0 1px 3px rgba(0,0,0,0.06);
            position: relative;
            animation: rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
        }

        @keyframes rise {
            from { opacity: 0; transform: translateY(28px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Icono check animado */
        .check-wrap {
            width: 80px;
            height: 80px;
            background: var(--green-light);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 28px;
            animation: pop 0.4s 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
        }

        @keyframes pop {
            from { transform: scale(0); }
            to   { transform: scale(1); }
        }

        .check-wrap svg {
            width: 40px;
            height: 40px;
            stroke: var(--green);
            stroke-width: 2.5;
            fill: none;
            stroke-dasharray: 60;
            stroke-dashoffset: 60;
            animation: draw 0.45s 0.65s ease forwards;
        }

        @keyframes draw {
            to { stroke-dashoffset: 0; }
        }

        h1 {
            font-family: 'DM Serif Display', serif;
            font-size: 2rem;
            color: var(--text);
            text-align: center;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: var(--muted);
            font-size: 0.95rem;
            margin-bottom: 32px;
        }

        /* Detalles de la cita */
        .details {
            background: var(--violet-light);
            border-radius: 14px;
            padding: 20px 24px;
            margin-bottom: 32px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .detail-row {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.95rem;
            color: var(--text);
        }

        .detail-row .icon {
            font-size: 1.2rem;
            flex-shrink: 0;
        }

        .detail-row strong {
            font-weight: 500;
        }

        /* Token badge */
        .token-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: 0.78rem;
            font-family: 'Courier New', monospace;
            color: var(--muted);
            word-break: break-all;
        }

        /* Botones */
        .btn-primary {
            display: block;
            width: 100%;
            text-align: center;
            background: var(--violet);
            color: #fff;
            padding: 14px;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            font-size: 1rem;
            text-decoration: none;
            transition: background 0.2s, transform 0.15s;
            margin-bottom: 12px;
        }

        .btn-primary:hover {
            background: #6d28d9;
            transform: translateY(-1px);
        }

        .btn-secondary {
            display: block;
            width: 100%;
            text-align: center;
            color: var(--violet);
            padding: 12px;
            border-radius: 10px;
            font-family: 'DM Sans', sans-serif;
            font-weight: 500;
            font-size: 0.95rem;
            text-decoration: none;
            border: 1.5px solid var(--violet);
            transition: background 0.2s;
        }

        .btn-secondary:hover {
            background: var(--violet-light);
        }

        .divider {
            border: none;
            border-top: 1px solid #f0eeff;
            margin: 28px 0;
        }

        .footer-note {
            text-align: center;
            font-size: 0.82rem;
            color: var(--muted);
        }

        @media (max-width: 500px) {
            .card { padding: 36px 24px; }
            h1 { font-size: 1.65rem; }
        }
    </style>
</head>
<body>
    <div class="card">
        <div class="check-wrap">
            <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
            </svg>
        </div>

        <h1>¡Cita Confirmada!</h1>
        <p class="subtitle">Tu asistencia ha sido registrada con éxito.</p>

        <div class="details">
            {event.title && (
                <div class="detail-row">
                    <span class="icon">📌</span>
                    <span><strong>{event.title}</strong></span>
                </div>
            )}
            {event.date && (
                <div class="detail-row">
                    <span class="icon">📅</span>
                    <span><strong>Fecha:</strong>&nbsp;{event.date}</span>
                </div>
            )}
            {event.startTime && (
                <div class="detail-row">
                    <span class="icon">⏰</span>
                    <span><strong>Hora:</strong>&nbsp;{event.startTime}{event.endTime ? ` – ${event.endTime}` : ''}</span>
                </div>
            )}
            <div class="detail-row">
                <span class="icon">🔑</span>
                <span class="token-badge">🔒 {token}</span>
            </div>
        </div>

        {event.meetingLink && (
            <a href={event.meetingLink} class="btn-primary">
                🎥 Unirse a la Videollamada
            </a>
        )}
        <a href="/agenda" class="btn-secondary">
            ← Volver a la Agenda
        </a>

        <hr class="divider" />
        <p class="footer-note">
            Recibirás un recordatorio antes de tu cita.<br/>
            Psicologic &mdash; Tu bienestar es nuestra prioridad.
        </p>
    </div>
</body>
</html>