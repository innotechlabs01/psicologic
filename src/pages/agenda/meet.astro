---
import LayoutClient from "../../layouts/LayoutClient.astro";
import { VideoRoom } from "../../features/agenda/VideoRoom";

const token = Astro.url.searchParams.get("token");
const role = Astro.url.searchParams.get("role") || "client";
---

<LayoutClient title="Videollamada">
    <div class="h-screen w-full overflow-hidden">
        <VideoRoom
            client:only="react"
            meetingToken={token || "demo"}
            userType={role as 'host' | 'client'}
        />
    </div>
</LayoutClient>
