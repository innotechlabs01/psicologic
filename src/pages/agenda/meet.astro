---
// pages/agenda/video-room.astro (o como se llame tu página)
import LayoutVideoCall from "../../layouts/LayoutVideoCall.astro";
import VideoRoom from "../../components/Agenda/VideoRoom";
import { getEventByToken } from "../../lib/turso/agenda/agenda-db";

const token = Astro.url.searchParams.get("token");
const { userId } = Astro.locals.auth();

if (!token) {
    return Astro.redirect("/agenda");
}

const event = await getEventByToken(token);

if (!event) {
    return Astro.redirect("/agenda?error=invalid_token");
}

const role = userId && userId === event.userId ? "host" : "client";
---

<LayoutVideoCall title="Video Call">
    <div class="video-wrapper">
        <VideoRoom
            client:only="react"
            meetingToken={token}
            userType={role as any}
        />
    </div>
</LayoutVideoCall>

<style>
    .video-wrapper {
        position: fixed;
        inset: 0;
        width: 100dvw;
        height: 100dvh;
        background: #000;
        overflow: hidden;
    }

    /* Responsivo: en móvil aseguramos que no haya barras del navegador */
    @media (max-width: 640px) {
        .video-wrapper {
            /* Usa dvh para manejar la barra de navegación del móvil */
            height: 100dvh;
        }
    }
</style>