---
import LayoutClient from "../../layouts/LayoutClient.astro";
import VideoRoom from "../../components/Agenda/VideoRoom";
import { getEventByToken } from "../../lib/turso/agenda/agenda-db";

const token = Astro.url.searchParams.get("token");
const { userId } = Astro.locals.auth();

if (!token) {
    return Astro.redirect("/agenda");
}

// Logic to determine role:
// 1. Fetch event from DB using the secure token
// 2. If current userId matches event.userId, they are the HOST
// 3. Otherwise, they are the CLIENT
const event = await getEventByToken(token);

if (!event) {
    return Astro.redirect("/agenda?error=invalid_token");
}

const role = userId && userId === event.userId ? "host" : "client";
---

<LayoutClient title="Video Call">
    <div class="h-screen w-full overflow-hidden bg-black">
        <VideoRoom
            client:only="react"
            meetingToken={token}
            userType={role as any}
        />
    </div>
</LayoutClient>
