name: Deploy to Vercel

on:
  push:
    branches:
      - productive
  pull_request:
    branches:
      - productive

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      DEPLOY_ENV: vercel
      CLERK_SECRET_KEY: ${{ secrets.CLERK_SECRET_KEY }}
      CLERK_PUBLISHABLE_KEY: ${{ secrets.CLERK_PUBLISHABLE_KEY }}

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Create .nojekyll to disable Jekyll
        run: touch .nojekyll  # Crea el archivo vacío para omitir Jekyll en Pages

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build Astro project
        run: npm run build
        env:
          NODE_ENV: production

      - name: Verify build output
        run: |
          ls -la dist/  # Verifica que dist tenga archivos (para debug)
          if [ ! -f "dist/index.html" ]; then
            echo "Build failed: No index.html in dist"
            exit 1
          fi

      - name: Deploy to Vercel
        uses: amondnet/vercel-action@v25
        with:
          vercel-token: ${{ secrets.VERCEL_TOKEN }}
          vercel-org-id: ${{ secrets.VERCEL_ORG_ID }}
          vercel-project-id: ${{ secrets.VERCEL_PROJECT_ID }}
          vercel-args: ${{ github.event_name == 'push' && '--prod' || '' }}