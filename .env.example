# Email Configuration (Nodemailer)
# Use 'smtp.gmail.com' for Gmail, or your provider's host
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# For Gmail, this is your email address
SMTP_USER=tu_correo@gmail.com
# For Gmail, generate an 'App Password' if 2FA is on
SMTP_PASS=tu_contraseña_de_aplicacion
SMTP_SECURE=false

# Optional: Public URL (for meeting links if not auto-detected)
# PUBLIC_SITE_URL=http://localhost:4321

# Environment
NODE_ENV=production
DEPLOY_ENV=vercel