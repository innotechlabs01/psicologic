# Clerk Authentication
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Turso Database
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_token
PUBLIC_TURSO_DATABASE_URL=libsql://your-database.turso.io
PUBLIC_TURSO_AUTH_TOKEN=your_turso_token

# Epayco Payment
EPAYCO_PUBLIC_KEY=your_epayco_key
EPAYCO_P_KEY=your_epayco_pkey

# Base Path
BASE_PATH=https://your-domain.com

# SMTP Email Configuration (Nodemailer)
# Gmail: usa una "App Password" (no tu contraseña normal)
# https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tuemail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=Psicologic <noreply@tudominio.com>

# Cron Job Secret (genera con: openssl rand -base64 32)
CRON_SECRET=your_cron_secret_here

# Environment
NODE_ENV=production
DEPLOY_ENV=vercel
