#!/usr/bin/env bash
# pre-commit guard: blocks build artifacts and secrets from being committed.
# Install with: make install-hooks
set -uo pipefail

violations=0

while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    dist/*|.astro/*|.DS_Store|*/.DS_Store|*.pem|e2e/credentials.env)
      echo "BLOCKED: '$f' is a build artifact or secret file — unstage it." >&2
      violations=1
      ;;
    .env|.env.local|.env.*)
      if [ "$f" != ".env.example" ]; then
        echo "BLOCKED: '$f' looks like real env config — only .env.example is committable." >&2
        violations=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only)

while IFS= read -r f; do
  [ -n "$f" ] || continue
  [ -f "$f" ] || continue
  size=$(wc -c <"$f" 2>/dev/null | tr -d ' ')
  if [ "${size:-0}" -gt 1000000 ]; then
    echo "BLOCKED: '$f' is larger than 1 MB — exclude it or use Git LFS." >&2
    violations=1
  fi
done < <(git diff --cached --name-only)

exit "$violations"
